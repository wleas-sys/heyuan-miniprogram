<view wx:if="{{!hidden}}" class="tabbar">
  <button wx:for="{{list}}" wx:key="path" class="tab {{selected === index ? 'selected' : ''}}" data-path="{{item.path}}" bindtap="go" aria-label="{{item.text}}">
    <view class="icon-shell">
      <image class="tab-icon" src="{{selected === index ? item.selectedIcon : item.icon}}" mode="aspectFit" />
    </view>
    <text class="tab-label">{{item.text}}</text>
  </button>
</view>
