page {
  --paper: #F6F7F3; --ink: #203A31; --muted: #748279;
  --line: #E1E8DE; --green: #173F35; --soft: #EAF0E7;
  background: var(--paper); color: var(--ink);
  font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size: 28rpx; line-height: 1.65;
}
view,button,input,text,textarea,scroll-view,swiper,swiper-item { box-sizing: border-box; }
button { font: inherit; margin: 0; padding: 0; background: none; color: inherit; border: 0; border-radius: 0; line-height: 1.5; }
button:not([size="mini"]) { width: auto; margin: 0; }
button::after { border: 0; }
button[disabled] { opacity: .4; color: inherit; background: none; }
button.primary[disabled] { background: var(--green); color: #fff; }
.page { padding: 32rpx 32rpx 64rpx; min-height: 100vh; }
.tab-page { padding-bottom: calc(166rpx + env(safe-area-inset-bottom)); }
.with-dock { padding-bottom: calc(182rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: var(--green); font-size: 21rpx; font-weight: 600; letter-spacing: 3rpx; }
.title { font-size: 48rpx; line-height: 1.35; font-weight: 650; letter-spacing: -1rpx; margin: 14rpx 0 16rpx; }
.subtitle { font-size: 26rpx; color: var(--muted); line-height: 1.8; }
.section { margin-top: 38rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; line-height: 1.5; font-weight: 650; letter-spacing: -.4rpx; }
.link { color: var(--green); font-size: 25rpx; text-align: left; padding: 15rpx 0; }
.card { background: #fff; border: 1rpx solid var(--line); border-radius: 28rpx; padding: 28rpx; }
.card + .card { margin-top: 18rpx; }
.body { font-size: 27rpx; line-height: 1.85; }
.muted { color: var(--muted); }
.small { font-size: 23rpx; }
.tiny { font-size: 21rpx; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.grow { flex: 1; min-width: 0; }
.tag { display: inline-block; padding: 5rpx 12rpx; border-radius: 8rpx; background: var(--soft); color: var(--green); font-size: 21rpx; margin-right: 10rpx; }
.pill { display: inline-flex; align-items: center; justify-content: center; padding: 14rpx 24rpx; border: 1rpx solid var(--line); background: #fff; border-radius: 40rpx; font-size: 25rpx; }
.pill.active { color: #fff; background: var(--green); border-color: var(--green); }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.primary { padding: 24rpx 28rpx; background: var(--green); color: #fff; border-radius: 18rpx; font-size: 28rpx; font-weight: 550; text-align: center; }
.secondary { padding: 22rpx 26rpx; border: 1rpx solid #C6D4C9; border-radius: 18rpx; color: var(--green); background: #F9FBF7; font-size: 27rpx; text-align: center; }
.compact { padding: 13rpx 20rpx; font-size: 24rpx; }
.danger { color: #9D5142; }
.divider { height: 1rpx; background: var(--line); margin: 24rpx 0; }
.notice { padding: 22rpx 24rpx; border-left: 3rpx solid #B9A77E; background: #F0EDE3; color: #776C52; font-size: 24rpx; line-height: 1.8; border-radius: 0 16rpx 16rpx 0; }
.notice + .notice { margin-top: 12rpx; }
.field { padding: 20rpx 22rpx; background: #F8FAF6; border: 1rpx solid var(--line); border-radius: 16rpx; min-height: 88rpx; font-size: 28rpx; width: 100%; }
.field-label { display: block; font-size: 25rpx; margin-bottom: 10rpx; color: #596D60; }
.form-row { margin-bottom: 24rpx; }
.empty { padding: 56rpx 30rpx; border: 1rpx solid #DDE7D9; background: #EDF2E9; border-radius: 26rpx; text-align: center; }
.empty-title { font-size: 31rpx; color: #365640; margin-bottom: 12rpx; }
.empty .primary { margin-top: 26rpx; }
.dock { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid var(--line); display: flex; gap: 16rpx; z-index: 20; box-shadow: 0 -6rpx 24rpx rgba(23,63,53,.035); }
.dock button { flex: 1; min-width: 0; }
.end-note { margin: 36rpx 0 8rpx; font-size: 22rpx; line-height: 1.8; color: var(--muted); text-align: center; }
.place-mark { width: 96rpx; height: 106rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; font-family: "Songti SC","SimSun",serif; font-size: 44rpx; background: #DCE8D7; color: #46624B; }
.place-mark.sand { background: #ECE6D5; color: #7A6D51; }
.place-mark.clay { background: #ECE0D5; color: #936750; }
.place-name { font-size: 30rpx; line-height: 1.5; font-weight: 600; }
.place-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.place-item:first-child { padding-top: 0; }
.arrow { font-size: 36rpx; color: var(--green); }
.stat { font-size: 44rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.two-col { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 20rpx; }
.source { padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.source:last-child { border-bottom: 0; }
.list-line { padding: 10rpx 0; font-size: 26rpx; line-height: 1.85; }
.step-no { color: var(--green); font-size: 24rpx; font-weight: 650; width: 48rpx; height: 48rpx; border-radius: 50%; background: #EAF0E5; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.block-photo { width: 100%; height: 370rpx; display: block; border-radius: 24rpx; background: #E1E8DB; }
.block-photo.portrait-photo { height: auto; }
.timeline-notice { padding: 24rpx 32rpx; background: #EAF0E7; color: var(--green); font-size: 24rpx; line-height: 1.7; }
.pressed { opacity: .76; }
.photo-frame { border-radius: 24rpx; overflow: hidden; background: #E2E8DC; }
.photo-frame .block-photo { border-radius: 0; }
.portrait-frame { padding: 20rpx; background: #E7EBE1; }
.portrait-frame .block-photo.portrait-photo { height: 420rpx; width: 100%; background: transparent; }
.photo-frame + .tiny { font-size: 20rpx; line-height: 1.7; margin-top: 12rpx; color: #7F8B7D; }
