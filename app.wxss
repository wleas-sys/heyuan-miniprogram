page {
  --paper: #FAF8F1; --paper-2: #F1EDE1; --ink: #141C17; --ink-2: #2B372F; --muted: #55625A;
  --line: #D8D2C0; --line-strong: #BDB69F; --green: #173B2C; --green-deep: #0F2A1F;
  --soft: #EDF0E4; --seal: #A6402C; --gold: #9C824F; --card: #FFFDF6;
  --hairline: #DED9C9;
  --shadow-sm: none; --shadow-md: none;
  --serif: "Songti SC","STSong","Noto Serif CJK SC","Source Han Serif SC","SimSun",Georgia,serif;
  background: var(--paper); color: var(--ink);
  font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size: 28rpx; line-height: 1.68;
  -webkit-font-smoothing: antialiased;
}
view,button,input,text,textarea,scroll-view,swiper,swiper-item { box-sizing: border-box; }
button { font: inherit; margin: 0; padding: 0; background: none; color: inherit; border: 0; border-radius: 0; line-height: 1.5; }
button:not([size="mini"]) { width: auto; margin: 0; }
button::after { border: 0; }
button[disabled] { opacity: .4; color: inherit; background: none; }
button.primary[disabled] { background: var(--green); color: #fff; }
.page { padding: 32rpx 32rpx 64rpx; min-height: 100vh; }
.tab-page { padding-bottom: calc(166rpx + env(safe-area-inset-bottom)); }
.with-dock { padding-bottom: calc(182rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: var(--seal); font-size: 19rpx; font-weight: 600; letter-spacing: 5rpx; }
.title { font-family: var(--serif); font-size: 56rpx; line-height: 1.24; font-weight: 600; letter-spacing: 0; margin: 16rpx 0 18rpx; }
.subtitle { font-size: 25rpx; color: var(--ink-2); line-height: 1.85; }
.section { margin-top: 46rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.section-title { font-family: var(--serif); font-size: 35rpx; line-height: 1.45; font-weight: 600; letter-spacing: .5rpx; }
.link { color: var(--green); font-size: 25rpx; text-align: left; padding: 15rpx 0; }
.card { background: var(--card); border: 1rpx solid var(--line); border-radius: 22rpx; padding: 30rpx; box-shadow: none; }
.card + .card { margin-top: 18rpx; }
.body { font-size: 27rpx; line-height: 1.9; color: var(--ink-2); }
.muted { color: var(--muted); }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.grow { flex: 1; min-width: 0; }
.tag { display: inline-block; padding: 4rpx 12rpx; border-radius: 6rpx; background: transparent; border: 1rpx solid var(--line-strong); color: var(--ink-2); font-size: 20rpx; letter-spacing: 1rpx; }
.pill { display: inline-flex; align-items: center; justify-content: center; padding: 14rpx 24rpx; border: 1rpx solid var(--line-strong); background: transparent; border-radius: 12rpx; font-size: 25rpx; letter-spacing: .5rpx; }
.pill.active { color: var(--paper); background: var(--green); border-color: var(--green); }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.primary { padding: 26rpx 28rpx; color: var(--paper); border-radius: 14rpx; font-size: 28rpx; font-weight: 600; text-align: center; letter-spacing: 2rpx; background: var(--green); box-shadow: none; }
.secondary { padding: 24rpx 26rpx; border: 1rpx solid var(--green); border-radius: 14rpx; color: var(--green); background: transparent; font-size: 27rpx; text-align: center; letter-spacing: 1rpx; box-shadow: none; }
.compact { padding: 13rpx 20rpx; font-size: 24rpx; }
.danger { color: #9D5142; }
.divider { height: 1rpx; margin: 26rpx 0; background: var(--line); }
.notice { padding: 22rpx 24rpx; border-left: 3rpx solid var(--seal); background: var(--paper-2); color: #6B5F49; font-size: 24rpx; line-height: 1.8; border-radius: 0; }
.notice + .notice { margin-top: 12rpx; }
.field { padding: 20rpx 22rpx; background: var(--paper); border: 1rpx solid var(--line); border-radius: 14rpx; min-height: 88rpx; font-size: 28rpx; width: 100%; }
.field-label { display: block; font-size: 23rpx; margin-bottom: 10rpx; color: var(--ink-2); letter-spacing: 2rpx; }
.form-row { margin-bottom: 24rpx; }
.empty { padding: 56rpx 30rpx; border: 1rpx dashed var(--line-strong); background: transparent; border-radius: 18rpx; text-align: center; }
.empty-title { font-family: var(--serif); font-size: 32rpx; color: var(--ink); margin-bottom: 12rpx; font-weight: 600; }
.empty .primary { margin-top: 26rpx; }
.dock { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1rpx solid var(--line); display: flex; gap: 16rpx; z-index: 20; box-shadow: none; }
.dock button { flex: 1; min-width: 0; }
.end-note { margin: 44rpx 0 8rpx; font-size: 21rpx; line-height: 1.9; color: var(--muted); text-align: center; letter-spacing: 2rpx; }
.place-mark { width: 96rpx; height: 106rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; font-family: var(--serif); font-size: 44rpx; background: var(--paper-2); border: 1rpx solid var(--line); color: var(--ink-2); letter-spacing: 2rpx; }
.place-mark.sand { background: #ECE6D5; color: #7A6D51; }
.place-mark.clay { background: #ECE0D5; color: #936750; }
.place-name { font-size: 30rpx; line-height: 1.5; font-weight: 600; }
.place-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.place-item:first-child { padding-top: 0; }
.arrow { font-size: 36rpx; color: var(--green); }
.stat { font-family: var(--serif); font-size: 50rpx; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: 0; }
.two-col { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 20rpx; }
.source { padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.source:last-child { border-bottom: 0; }
.list-line { padding: 10rpx 0; font-size: 26rpx; line-height: 1.85; }
.step-no { color: var(--green); font-size: 24rpx; font-weight: 650; width: 48rpx; height: 48rpx; border-radius: 50%; background: #EAF0E5; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.block-photo { width: 100%; height: 370rpx; display: block; border-radius: 24rpx; background: #E1E8DB; }
.block-photo.portrait-photo { height: auto; }
.timeline-notice { padding: 24rpx 32rpx; background: #EAF0E7; color: var(--green); font-size: 24rpx; line-height: 1.7; }
.pressed { opacity: .78; transform: scale(.972); }
/* 按下快速到位（.07s），松手用带过冲的曲线弹回，才有“重量” */
.pressed { transition-duration: .07s !important; transition-timing-function: ease-out !important; }
.photo-frame { border-radius: 24rpx; overflow: hidden; background: #E2E8DC; }
.photo-frame .block-photo { border-radius: 0; }
.portrait-frame { padding: 20rpx; background: #E7EBE1; }
.portrait-frame .block-photo.portrait-photo { height: 420rpx; width: 100%; background: transparent; }
.photo-frame + .tiny { font-size: 20rpx; line-height: 1.7; margin-top: 12rpx; color: #7F8B7D; }
/* 统一手感：按下快、松手回弹；只列常见可点卡片，避免给全部节点加合成层 */
.place-card,.route-card,.destination-card,.chat-entry,.resume-card,.saved-plan,.stat-card,.plan-card,.result-card,.draft-entry,.stop { transition: transform .36s cubic-bezier(.34,1.56,.64,1), opacity .2s ease; }
button { transition: transform .36s cubic-bezier(.34,1.56,.64,1), opacity .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease; }
/* 长按/点击后的小幅缩放，配合 hover-class="pressed" 使用 */
.tap-scale { transition: transform .18s cubic-bezier(.2,.8,.3,1), opacity .18s ease; }
/* 页面内提示条（如“已移除 · 撤销”），固定在安全区上方 */
.snackbar { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(140rpx + env(safe-area-inset-bottom)); z-index: 150; display: flex; align-items: center; gap: 16rpx; padding: 20rpx 22rpx; background: #1E3B31; color: #F4F7F1; border-radius: 18rpx; box-shadow: 0 12rpx 32rpx rgba(15,38,28,.22); animation: snackbar-in .22s ease-out both; }
.snackbar-text { flex: 1; min-width: 0; font-size: 24rpx; line-height: 1.5; }
.snackbar-action { flex-shrink: 0; padding: 8rpx 18rpx; border: 1rpx solid rgba(255,255,255,.32); border-radius: 12rpx; font-size: 24rpx; color: #EAF3E4; }
.snackbar-close { flex-shrink: 0; width: 52rpx; height: 52rpx; line-height: 50rpx; text-align: center; font-size: 32rpx; color: rgba(255,255,255,.6); }
@keyframes snackbar-in { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }
/* 水波：从手指落点扩散，只在主操作按钮上使用 */
.has-ripple { position: relative; overflow: hidden; }
.ripple { position: absolute; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: rgba(255, 255, 255, .4); pointer-events: none; transform: scale(0); animation: ripple-out .6s cubic-bezier(.22, .8, .3, 1) forwards; }
@keyframes ripple-out { 0% { transform: scale(0); opacity: .5; } 100% { transform: scale(13); opacity: 0; } }
/* 数字统一等宽，切换筛选或滚动计数时不跳动 */
.stat,.result-number,.cost-value,.schedule-time,.arrival-time,.plan-score,.check-count,.saved-meta,.ticket-reference,.day-count{font-variant-numeric:tabular-nums}
