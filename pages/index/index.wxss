nt:center;color:#667B63}.route-copy{min-width:0;flex:1}.route-meta{font-size:22rpx;color:#50705C;margin-bottom:8rpx}.route-meta text{color:#8C978F}.route-name{font-size:28rpx;line-height:1.45;font-weight:600}.route-subtitle{font-size:23rpx;line-height:1.6;color:#55625A;margin-top:7rpx}.route-arrow{font-size:34rpx;color:#829185;flex-shrink:0}.start-plan{border:1rpx solid #DDE6D7;border-radius:26rpx;padding:30rpx;background:#EDF2E7;margin-top:34rpx}.start-plan-title{font-size:30rpx;font-weight:600}.start-plan-note{font-size:24rpx;color:#74816E;margin-top:8rpx}.start-plan-action{display:flex;justify-content:space-between;align-items:center;font-size:25rpx;color:#31543B;font-weight:600;margin-top:24rpx;border-top:1rpx solid #D7E1D2;padding-top:20rpx}.start-plan-action text{font-size:31rpx}.food-entry{display:flex;align-items:center;gap:22rpx;border-top:1rpx solid #E1E8DE;border-bottom:1rpx solid #E1E8DE;padding:30rpx 4rpx;margin-top:38rpx}.food-word{width:67rpx;height:67rpx;line-height:67rpx;border-radius:20rpx;text-align:center;font-size:35rpx;color:#877451;background:#ECE7D7;font-family:"Songti SC",serif;flex-shrink:0}.food-title{font-size:27rpx;font-weight:600}.food-note{font-size:24rpx;color:#55625A;margin-top:5rpx}.food-arrow{font-size:32rpx;color:#76876F}.home .end-note{font-size:22rpx;color:#8B948C;padding-top:5rpx}@media(max-width:350px){.hero-title{font-size:36rpx}.route-photo{width:126rpx;height:148rpx}.route-meta{font-size:22rpx}.route-card{gap:17rpx}.scene-note{font-size:23rpx}}
