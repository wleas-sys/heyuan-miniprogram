/* 搜索框内一键清空，少删几个字 */
.home-search .clear-keyword{width:56rpx;height:56rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#F1F4EE;color:#55625A;font-size:34rpx;line-height:1}

/* ---- 质感层：首屏与卡片，只调材质不调结构 ---- */
.home-hero{border-radius:32rpx;border-color:rgba(26,50,38,.06);box-shadow:var(--shadow-md)}
.hero-shade{background:linear-gradient(180deg,rgba(10,38,29,.24),rgba(8,32,24,0) 34%,rgba(8,32,24,.16) 62%,rgba(8,32,24,.72))}
.hero-location{background:rgba(18,48,39,.3);border-color:rgba(255,255,255,.24);padding:9rpx 15rpx;letter-spacing:.4rpx}
.hero-title{font-size:44rpx;letter-spacing:2.4rpx;text-shadow:0 2rpx 14rpx rgba(0,0,0,.22)}
.hero-planner{padding:28rpx 26rpx}
.hero-planner-title{font-size:29rpx;letter-spacing:.2rpx}
.planner-hero-button{border-radius:20rpx;background:linear-gradient(180deg,#1F4C3E,#143A2F);box-shadow:0 2rpx 4rpx rgba(20,58,47,.16),0 10rpx 22rpx rgba(20,58,47,.18);letter-spacing:.6rpx}
.chat-entry{border-color:rgba(26,50,38,.07);background:linear-gradient(135deg,#F5F8F0,#E9F0E3);box-shadow:var(--shadow-sm);border-radius:26rpx}
.chat-entry-avatar{background:linear-gradient(160deg,#245144,#143A2F);box-shadow:0 4rpx 10rpx rgba(20,58,47,.2)}
.resume-card{border-color:rgba(26,50,38,.07);background:linear-gradient(135deg,#F1F5EB,#E8EFE2);box-shadow:var(--shadow-sm);border-radius:26rpx}
.home-search{border-color:#E3E7DC;background:var(--card);box-shadow:var(--shadow-sm)}
.section-overline{font-size:22rpx;letter-spacing:2.6rpx;color:#55625A;margin-bottom:8rpx}
.route-card{border-bottom-color:#EBEEE4}
.route-photo{border-radius:18rpx}
.route-name{font-size:29rpx;letter-spacing:-.2rpx}
.route-meta{letter-spacing:.4rpx}
.destination-card{border-color:rgba(26,50,38,.07);border-radius:26rpx;box-shadow:var(--shadow-sm);background:var(--card)}
.destination-visual{height:236rpx}
.destination-info{padding:18rpx 20rpx 22rpx}
.destination-name{font-size:29rpx;font-weight:600;letter-spacing:-.2rpx}
.destination-category{letter-spacing:.6rpx}
.food-entry{border-color:var(--hairline);margin-top:42rpx}

/* ===== 纸墨编辑风 · 首页重构 ===== */
.home{padding-top:20rpx}
.home-heading{align-items:flex-start;margin-bottom:26rpx}
.heading-main{min-width:0;flex:1}
.home-brand{display:flex;align-items:center;gap:14rpx}
.seal-mark{width:46rpx;height:46rpx;background:var(--seal);color:#FBF8F1;font-family:var(--serif);font-size:22rpx;line-height:1.06;letter-spacing:1rpx;display:flex;align-items:center;justify-content:center;text-align:center;padding:4rpx;border-radius:16rpx;flex-shrink:0}
.home-label{font-size:22rpx;letter-spacing:4rpx;color:var(--ink-2)}
.home-title{font-family:var(--serif);font-size:52rpx;line-height:1.22;font-weight:600;letter-spacing:1rpx;margin-top:16rpx;color:var(--ink)}
.home-title text{display:block;margin-left:0;color:var(--green)}
.home-feedback{border-radius:16rpx;background:transparent;border:1rpx solid var(--line-strong);color:var(--ink-2);letter-spacing:1rpx;min-height:60rpx;padding:12rpx 16rpx}
.feedback-bubble{border-color:var(--ink-2)}
.feedback-bubble:after{border-left-color:var(--ink-2)}

/* 封面：通栏、直角、压角更深 */
.home-hero{margin:0;border-radius:24rpx;border:1rpx solid var(--line);box-shadow:none;background:transparent;overflow:hidden}
.hero-visual{height:430rpx}
.hero-shade{background:linear-gradient(180deg,rgba(12,28,20,.3),rgba(12,28,20,.02) 40%,rgba(10,24,17,.78))}
.hero-location{border-radius:16rpx;background:rgba(12,28,20,.3);border:1rpx solid rgba(255,255,255,.4);letter-spacing:1.4rpx;font-size:22rpx;padding:8rpx 14rpx;left:32rpx;top:26rpx}
.hero-copy{left:32rpx;right:32rpx;bottom:34rpx}
.hero-kicker{font-size:22rpx;letter-spacing:4rpx;color:rgba(255,255,255,.82);margin-bottom:14rpx}
.hero-title{font-family:var(--serif);font-size:60rpx;font-weight:600;letter-spacing:2rpx;line-height:1.2;text-shadow:none}
.hero-rule{width:56rpx;height:3rpx;background:var(--seal);margin-top:20rpx}
.hero-planner{padding:24rpx 32rpx;background:var(--card);gap:18rpx;border-top:1rpx solid var(--line)}
.planner-index{font-family:var(--serif);font-size:40rpx;color:var(--seal);line-height:1;flex-shrink:0;letter-spacing:1rpx}
.hero-planner-title{font-family:var(--serif);font-size:30rpx;letter-spacing:.5rpx;color:var(--ink)}
.hero-planner-note{font-size:22rpx;color:var(--muted)}
.planner-hero-button{border-radius:16rpx;background:var(--green);box-shadow:none;letter-spacing:2rpx;font-weight:500;font-size:25rpx}

/* 入口与草稿：改为细线方块 */
.chat-entry{border-radius:16rpx;border:1rpx solid var(--line-strong);background:transparent;box-shadow:none;padding:22rpx 24rpx;gap:18rpx}
.chat-entry-avatar{border-radius:16rpx;background:var(--seal);box-shadow:none;font-family:var(--serif);font-size:27rpx;width:56rpx;height:56rpx}
.chat-entry-title{font-family:var(--serif);font-size:30rpx;font-weight:600;letter-spacing:.5rpx}
.chat-entry-note{font-size:22rpx;color:var(--muted);margin-top:5rpx}
.chat-entry-arrow{color:var(--seal)}
.resume-card{border-radius:16rpx;border:1rpx dashed var(--line-strong);background:transparent;box-shadow:none}
.resume-title{font-family:var(--serif)}
.home-manual{color:var(--ink-2);letter-spacing:.5rpx}

/* 搜索：方框 + 实心方按钮 */
.home-search{border-radius:16rpx;border:1rpx solid var(--line-strong);background:transparent;box-shadow:none}
.search-action{border-radius:16rpx;background:var(--green);color:var(--paper);letter-spacing:1rpx}
.home-search .clear-keyword{background:transparent;border-radius:50%;color:var(--muted)}

/* 分节：编号 + 宋体标题 */
.section-head{align-items:flex-start;gap:18rpx}
.sec-no{font-family:var(--serif);font-size:26rpx;color:var(--seal);letter-spacing:1rpx;flex-shrink:0;margin-top:8rpx}
.section-copy{flex:1;min-width:0}
.section-overline{font-size:22rpx;letter-spacing:3rpx;color:var(--muted);margin-bottom:6rpx}
.section-title{font-family:var(--serif);font-size:36rpx;letter-spacing:1rpx}
.view-all{font-size:22rpx;color:var(--ink-2);letter-spacing:1rpx}

/* 路线：编号清单 */
.route-card{padding:22rpx 0;border-bottom:1rpx solid var(--line)}
.route-photo{border-radius:12rpx}
.route-placeholder{border-radius:12rpx;background:var(--paper-2);color:var(--ink-2);font-family:var(--serif);border:1rpx solid var(--line)}
.route-name{font-family:var(--serif);font-size:31rpx;letter-spacing:.5rpx}
.route-meta{font-size:22rpx;letter-spacing:2rpx;color:var(--muted)}
.route-subtitle{font-size:23rpx;color:var(--ink-2)}
.route-arrow{color:var(--seal)}

/* 目的地：直角小卡 */
.destination-grid{gap:16rpx}
.destination-card{border-radius:16rpx;border:1rpx solid var(--line);background:var(--card);box-shadow:none}
.destination-visual{height:220rpx}
.destination-category{font-size:22rpx;letter-spacing:2rpx;background:rgba(12,28,20,.62);border-radius:16rpx;padding:5rpx 10rpx}
.destination-region{font-size:22rpx;letter-spacing:2rpx;color:var(--seal)}
.destination-name{font-family:var(--serif);font-size:31rpx;letter-spacing:.3rpx}
.destination-teaser{font-size:23rpx;color:var(--ink-2)}

/* 美食入口 */
.food-entry{border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);margin-top:44rpx;padding:28rpx 0;gap:20rpx}
.food-word{font-family:var(--serif);color:var(--seal);border:1rpx solid var(--seal);width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;font-size:38rpx}
.food-title{font-family:var(--serif);font-size:29rpx}
.food-note{font-size:22rpx;color:var(--muted)}
.food-arrow{color:var(--seal)}

/* ===== 重叠卡组：收起互压，散开看名字 ===== */
.route-deck{position:relative;margin-top:8rpx;transition:height .46s cubic-bezier(.22,1,.36,1)}
.route-sheet{position:absolute;left:0;right:0;height:158rpx;background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;overflow:hidden;transition:top .46s cubic-bezier(.22,1,.36,1)}
.route-sheet-head{height:52rpx;display:flex;align-items:center;gap:14rpx;padding:0 18rpx;border-bottom:1rpx solid var(--line);background:var(--card)}
.route-sheet-no{font-family:var(--serif);font-size:23rpx;color:var(--seal);letter-spacing:1rpx;flex-shrink:0}
.route-sheet-name{flex:1;min-width:0;font-family:var(--serif);font-size:26rpx;letter-spacing:.4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink)}
.route-sheet-meta{font-size:22rpx;color:var(--muted);letter-spacing:1rpx;flex-shrink:0}
.route-sheet-body{display:flex;align-items:center;gap:16rpx;padding:12rpx 18rpx;height:106rpx}
.route-sheet-photo{width:104rpx;height:82rpx;border-radius:16rpx;flex-shrink:0;background:var(--paper-2)}
.route-sheet .route-placeholder{border-radius:16rpx;background:var(--paper-2);color:var(--ink-2);font-family:var(--serif);border:1rpx solid var(--line);display:flex;align-items:center;justify-content:center;font-size:28rpx}
.route-sheet .route-meta{font-size:22rpx;letter-spacing:1rpx;color:var(--muted)}
.route-sheet .route-subtitle{font-size:22rpx;color:var(--ink-2);line-height:1.55;margin-top:4rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.route-sheet .route-arrow{color:var(--seal);font-size:26rpx;flex-shrink:0}
.route-deck-bar{display:flex;align-items:center;justify-content:space-between;padding-top:14rpx;min-height:56rpx}
.route-hint{font-size:22rpx;color:var(--muted);letter-spacing:1.2rpx}
.route-collapse{font-size:22rpx;color:var(--seal);letter-spacing:1rpx;padding:10rpx 0 10rpx 20rpx}

/* ===== 横向手风琴：等宽窄条，点开变宽，内容延迟淡入 ===== */
.scene-row{display:flex;gap:10rpx;padding:24rpx 0 6rpx;align-items:stretch}
.scene{flex:1;min-width:0;min-height:212rpx;text-align:left;padding:18rpx 16rpx;border:1rpx solid var(--line);background:transparent;display:flex;flex-direction:column;align-items:flex-start;transition:flex .36s cubic-bezier(.22,1,.36,1),background-color .3s ease;overflow:hidden}
.scene.active{flex:2.5;background:var(--paper-2)}
.scene-icon{margin:0 0 12rpx;width:52rpx;height:48rpx;flex-shrink:0}
.scene-title{font-family:var(--serif);font-size:24rpx;letter-spacing:.5rpx;color:var(--ink);white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
.scene-note{font-size:22rpx;color:var(--muted);line-height:1.55;margin-top:5rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.scene.active .scene-note{-webkit-line-clamp:4}
.scene-more{margin-top:auto;padding-top:14rpx;display:flex;flex-direction:column;gap:6rpx;opacity:0;animation:scene-in .34s ease-out .1s both}
.scene-count{font-size:22rpx;color:var(--muted);letter-spacing:1rpx}
.scene-go{font-size:22rpx;color:var(--seal);letter-spacing:1rpx}
@keyframes scene-in{from{opacity:0;transform:translateY(8rpx)}to{opacity:1;transform:none}}

/* 细节打磨：印章与封面圆角 */
.seal-mark{border-radius:10rpx}
.home-hero{border-radius:24rpx;margin:0}
.route-sheet{border-radius:16rpx}
