<view wx:if="{{singlePage}}" class="timeline-notice">正在预览分享内容。保存、编辑或查看更多，请点击微信底部的“前往小程序”。</view>
<view wx:if="{{draftError}}" class="page tab-page"><view class="card draft-recovery"><view class="section-title">暂时无法打开草稿</view><view class="notice">{{draftError}}</view><view class="small muted">原有内容已保留。成功重新读取前，暂停编辑以免覆盖。</view><view class="draft-recovery-actions"><button class="primary" bindtap="retryDraft">重新读取草稿</button><button wx:if="{{!singlePage}}" class="link" bindtap="recoverDraft">备份原草稿并新建</button></view></view></view>
<view class="page tab-page planner-page" wx:if="{{plan}}">
  <view class="between page-heading"><view><text class="eyebrow">万绿智游 · 行程规划</text><view class="title">让每趟旅程从容而至</view></view><button class="new-plan" bindtap="fresh" hover-class="pressed" aria-label="新建行程">＋<text>新建</text></button></view>
  <view class="setup-card card">
    <view class="between"><text class="field-label">行程名称</text><text class="autosave"><text class="status-dot"></text>本机自动存草稿</text></view>
    <input class="title-field" value="{{titleInput}}" maxlength="24" bindinput="title" placeholder="给这趟旅行起个名字" disabled="{{singlePage}}" />
    <view class="setup-divider"></view>
    <view class="between days-setting"><text class="field-label">玩几天</text><view class="segmented"><view class="segmented-track"><view class="segmented-thumb {{daysLiquid ? 'liquid' : ''}}" style="left: {{(plan.days.length - 1) * 20}}%"></view><button wx:for="{{dayOptions}}" wx:key="*this" class="{{plan.days.length === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="setDays">{{item}} 天</button></view></view></view>
    <view class="transport-options"><button wx:for="{{modes}}" wx:key="key" class="transport-option {{plan.mode === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="mode"><text class="option-dot"></text>{{item.label}}</button></view>
    <view class="timing-settings">
      <button class="timing-toggle" bindtap="toggleTiming"><view><text class="field-label">日期与每天的时间</text><view class="timing-summary">{{plan.timing.date || '日期待定'}}<text> · </text>{{startTime}}—{{endTime}}</view></view><view class="timing-edit fold-trigger"><text>{{timingOpen ? '收起' : '调整'}}</text><view class="fold-chevron {{timingOpen ? 'open' : ''}}"></view></view></button>
      <view wx:if="{{timingOpen}}" class="timing-form">
        <view class="date-setting"><picker mode="date" value="{{plan.timing.date}}" start="1900-01-01" end="2100-12-31" bindchange="changeDate" disabled="{{singlePage}}"><view class="date-picker"><text>出发日期</text><text>{{plan.timing.date || '请选择'}} ›</text></view></picker><button wx:if="{{plan.timing.date}}" bindtap="clearDate" class="clear-date">暂不定日期</button></view>
        <view class="two-col timing-clock-fields"><view><text class="field-label">每天开始游览</text><picker mode="time" value="{{startTime}}" data-key="start" bindchange="changeTime" disabled="{{singlePage}}"><view class="time-picker">{{startTime}}<text>⌄</text></view></picker></view><view><text class="field-label">期望结束游览</text><picker mode="time" value="{{endTime}}" data-key="end" bindchange="changeTime" disabled="{{singlePage}}"><view class="time-picker">{{endTime}}<text>⌄</text></view></picker></view></view>
        <view class="two-col timing-minute-fields"><view><text class="field-label">午餐与休息</text><view class="minute-editor"><input type="number" maxlength="3" value="{{minuteFields.lunch}}" data-kind="base" data-key="lunch" bindinput="stageMinutes" bindblur="minutes" disabled="{{singlePage}}" aria-label="午餐与休息分钟" /><text>分钟</text></view><text class="input-note">0–180，跨中午时加入</text></view><view><text class="field-label">每段路上默认预留</text><view class="minute-editor"><input type="number" maxlength="3" value="{{minuteFields.transfer}}" data-kind="base" data-key="transfer" bindinput="stageMinutes" bindblur="minutes" disabled="{{singlePage}}" aria-label="默认路上预留分钟" /><text>分钟</text></view><text class="input-note">0–360，已填路段保留</text></view></view>
      </view>
    </view>
  </view>
  <view class="itinerary-section section">
    <view class="section-head"><text class="section-title">每日时间表</text><text class="small muted">共 {{view.count}} 站 · 时间可调整</text></view>
    <view class="day-tabs"><button wx:for="{{view.days}}" wx:key="day" data-day="{{item.index}}" bindtap="selectDay" class="day-tab {{activeDay === item.index ? 'active' : ''}}"><text>第 {{item.day}} 天</text><text class="day-count">{{item.dateLabel || (item.places.length ? item.places.length + ' 个地点' : '待安排')}}</text><text wx:if="{{item.overflowMinutes}}" class="day-alert-dot"></text></button></view>
    <block wx:for="{{view.days}}" wx:for-item="day" wx:key="day">
      <view wx:if="{{activeDay === day.index}}" class="day-content">
        <view class="active-day-label">{{day.dateLabel}} · {{day.places.length}} 个地点</view>
        <view wx:if="{{day.places.length}}" class="schedule-overview"><view class="between"><view><text class="schedule-time">{{day.startText}}<text>—</text>{{day.finishText}}</text><view class="small muted">按当前填写的时间安排</view></view><text class="schedule-total">{{day.totalDurationText}}</text></view><view class="schedule-parts"><text>游览 {{day.visitDurationText}}</text><text>路上 {{day.travelDurationText}}</text><text>休息 {{day.breakDurationText}}</text></view></view>
        <view wx:if="{{day.overflowMinutes}}" class="schedule-warning"><text class="warning-title">超出期望结束时间 {{day.overflowDurationText}}</text><view>期望 {{day.endText}} 结束，当前排到 {{day.finishText}}。可减少停留、移到另一天，或调整结束时间。</view></view>
        <view wx:if="{{day.missingTransfers}}" class="transfer-warning">{{day.missingTransfers}} 段路上时间待核对，正在按默认预留计算。查过地图后，把预计分钟填在两站之间。</view>
        <view class="timeline-list">
          <block wx:for="{{day.places}}" wx:for-item="place" wx:key="id">
            <view wx:if="{{place.travelKey}}" class="transfer-row"><text class="transfer-line"></text><view class="transfer-content"><view><view class="transfer-title">前往下一站 <text class="transfer-state {{place.travelConfirmed ? 'confirmed' : ''}}">{{place.travelConfirmed ? '已填写' : '待核对'}}</text></view><text class="transfer-hint">{{place.travelConfirmed ? '按你填写的路上时间' : '默认预留，请查实际路程'}}</text></view><view class="transfer-minutes"><input type="number" maxlength="3" value="{{minuteFields.legs[place.travelKey]}}" data-kind="leg" data-key="{{place.travelKey}}" bindinput="stageMinutes" bindblur="minutes" disabled="{{singlePage}}" aria-label="前往{{place.name}}的路上分钟" /><text>分钟</text></view></view></view>
            <view wx:if="{{place.breakBefore}}" class="meal-break"><text class="break-mark">休</text><view><text>午餐与休息 · {{place.breakBefore}} 分钟</text><view class="small muted">给中午留一段空白</view></view></view>
            <view class="timeline-item">
              <view class="timeline-rail"><text class="stop-number">{{place.order}}</text><view wx:if="{{place.canDown}}" class="rail-line"></view></view>
              <view class="stop card {{flashId === place.id ? 'just-added' : ''}} {{leavingId === place.id ? 'leaving' : ''}}" id="stop-{{place.id}}">
                <view class="stop-time"><text class="arrival-time">{{place.arriveText}}<text> 到达</text></text><text class="leave-time">{{place.leaveText}} 结束</text></view>
                <view class="stop-main" data-id="{{place.id}}" bindtap="detail" hover-class="pressed">
                  <image wx:if="{{place.photo && !failedPhotos[place.id]}}" class="stop-photo" src="{{place.photo}}" mode="aspectFill" lazy-load data-id="{{place.id}}" binderror="photoError" />
                  <view wx:else class="stop-photo photo-placeholder"><text>{{place.mark}}</text></view>
                  <view class="grow"><text class="stop-region">{{place.region}} · {{place.category}}</text><view class="place-name">{{place.name}}</view><view class="stop-duration">参考：{{place.durationText}}</view></view><text class="detail-arrow">›</text>
                </view>
                <view class="stop-adjust-heading"><text>停留 {{place.visitDurationText}}</text><button class="fold-trigger" data-id="{{place.id}}" bindtap="toggleStop"><text>{{expandedStop === place.id ? '收起调整' : '调整这一站'}}</text><view class="fold-chevron {{expandedStop === place.id ? 'open' : ''}}"></view></button></view><view wx:if="{{expandedStop === place.id}}"><view class="stop-timing"><text>这一站停留</text><view class="visit-minutes"><input type="number" maxlength="3" value="{{minuteFields.visits[place.id]}}" data-kind="visit" data-key="{{place.id}}" bindinput="stageMinutes" bindblur="minutes" disabled="{{singlePage}}" aria-label="{{place.name}}停留分钟" /><text>分钟</text><text class="edit-indicator">可改</text></view></view>
                <view wx:if="{{place.breakDuring}}" class="inside-break">{{place.breakStartText}}—{{place.breakEndText}} 午餐与休息，另留 {{place.breakDuring}} 分钟</view>
                <view class="stop-actions"><button data-day="{{day.index}}" data-index="{{place.index}}" data-delta="-1" bindtap="move" disabled="{{!place.canUp}}" aria-label="上移{{place.name}}">↑ 上移</button><button data-day="{{day.index}}" data-index="{{place.index}}" data-delta="1" bindtap="move" disabled="{{!place.canDown}}" aria-label="下移{{place.name}}">↓ 下移</button><button data-day="{{day.index}}" data-index="{{place.index}}" bindtap="openPicker">替换</button><button class="remove-action" data-day="{{day.index}}" data-index="{{place.index}}" bindtap="remove">移除</button></view>
                <button wx:if="{{plan.days.length > 1}}" class="move-day" data-day="{{day.index}}" data-index="{{place.index}}" bindtap="moveDay">移到另一天 ↗</button></view>
              </view>
            </view>
          </block>
          <view wx:for="{{day.afterBreaks}}" wx:key="startText" class="meal-break"><text class="break-mark">休</text><view>{{item.startText}}—{{item.endText}} 午餐与休息 · {{item.minutes}} 分钟</view></view>
        </view>
        <view wx:if="{{!day.places.length}}" class="empty day-empty"><view class="empty-symbol">＋</view><view class="empty-title">第 {{day.day}} 天，还没想好去哪？</view><view class="small muted">选好偏好生成一份方案，再按自己的节奏调整。</view><button wx:if="{{!view.count}}" class="primary generate-plan" bindtap="generate" disabled="{{singlePage}}">按偏好生成方案 →</button><text wx:if="{{!view.count}}" class="manual-hint">也可以从下面开始，手动添加地点</text></view>
        <button class="add-stop" data-day="{{day.index}}" bindtap="openPicker" disabled="{{day.places.length >= 4}}">{{day.places.length >= 4 ? '这一天已安排 4 站' : '＋ 添加地点'}}</button>
        <view wx:for="{{day.notes}}" wx:key="*this" class="notice day-note">{{item}}</view>
      </view>
    </block>
    <view class="schedule-note">时间表按你填写的停留、休息和路上时间顺排，不是实时导航。未计入出发地到首站、末站返回住处、跨日交通、排队和临时停留；营业时间、预约与交通仍需出发前核对。</view>
  </view>
  <view wx:if="{{view.count}}" class="section card budget-panel">
    <button class="panel-toggle" bindtap="toggleBudget"><view><view class="section-title">参考预算与记录</view><view class="small muted">{{view.estimate.caption}} </view></view><view class="cost-summary"><text class="cost-value">{{view.estimate.text}}</text><view class="small muted cost-unit">/ 人<view class="disclosure fold-chevron {{budgetOpen ? 'open' : ''}}"></view></view></view></button>
    <view wx:if="{{budgetOpen}}" class="budget-detail">
      <view class="budget-caption">{{view.estimate.assumptions}}</view>
      <view wx:if="{{view.count}}" class="ticket-fields"><text class="field-group-label">各站门票</text><block wx:for="{{view.days}}" wx:for-item="day" wx:key="day"><view wx:for="{{day.places}}" wx:for-item="place" wx:key="id" class="ticket-line"><view class="ticket-name"><text>{{place.name}}</text><view class="ticket-reference" wx:if="{{place.ticketReference}}">参考 ¥{{place.ticketReference.low}}{{place.ticketReference.high !== place.ticketReference.low ? '–' + place.ticketReference.high : ''}} · {{place.ticketReference.label}}<view class="ticket-reference-note">{{place.ticketReference.note}}</view><button class="link" data-id="{{place.id}}" bindtap="ticketSource">查看来源（复制链接）</button></view><view wx:else class="ticket-reference">暂无可靠票价，按实际填写</view></view><view class="money-input"><text>¥</text><input type="number" maxlength="4" placeholder="自填金额" value="{{place.ticketInput}}" data-id="{{place.id}}" bindinput="ticket" disabled="{{singlePage}}" /></view></view></block></view>
      <view class="two-col fee-form"><view><text class="field-label">餐饮 / 天 / 人</text><input class="field" type="number" maxlength="4" placeholder="¥ 未填写" value="{{plan.meal === null ? '' : plan.meal}}" data-key="meal" bindinput="money" disabled="{{singlePage}}" /></view><view><text class="field-label">全程交通 / 人</text><input class="field" type="number" maxlength="5" placeholder="¥ 未填写" value="{{plan.transport === null ? '' : plan.transport}}" data-key="transport" bindinput="money" disabled="{{singlePage}}" /></view><view wx:if="{{plan.days.length > 1}}"><text class="field-label">住宿 / 晚 / 人</text><input class="field" type="number" maxlength="4" placeholder="¥ 未填写" value="{{plan.lodging === null ? '' : plan.lodging}}" data-key="lodging" bindinput="money" disabled="{{singlePage}}" /></view><view><text class="field-label">总预算 / 人（选填）</text><input class="field" type="number" maxlength="5" placeholder="¥ 未设置" value="{{plan.budget === null ? '' : plan.budget}}" data-key="budget" bindinput="money" disabled="{{singlePage}}" /></view></view>
      <view wx:for="{{view.warnings}}" wx:key="*this" class="notice">{{item}}</view>
    </view>
    <view wx:if="{{!budgetOpen && plan.budget !== null && view.subtotal > plan.budget}}" class="budget-over">已填费用超出预算 ¥{{view.subtotal - plan.budget}}</view>
  </view>
  <view wx:if="{{view.count}}" class="section card departure-panel"><button class="section-head departure-toggle" bindtap="toggleChecks"><view><text class="section-title">出发前，逐项确认</text><view class="small muted">{{checksChanged ? '行程已调整，请重新确认' : '只记在本机，不随行程分享'}}</view></view><view class="check-count fold-trigger"><text>{{checkedCount}} / {{checks.length}}</text><view class="fold-chevron {{checksOpen ? 'open' : ''}}"></view></view></button><view wx:if="{{checksOpen}}"><button wx:for="{{checks}}" wx:key="id" class="check-item {{item.done ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleCheck" disabled="{{!checksAvailable || singlePage}}"><view class="check-box"><view class="check-stroke stroke-a"></view><view class="check-stroke stroke-b"></view></view><view class="grow"><view class="check-title">{{item.title}}</view><view class="check-note">{{item.note}}</view></view></button><view wx:if="{{!checksAvailable}}" class="small muted">清单暂时无法读取，重新进入本页可重试。</view></view></view>
  <view class="section two-col plan-bottom-actions"><button class="secondary" bindtap="save" disabled="{{!view.complete}}">{{saved ? '已保存 ✓' : '保存行程'}}</button><button id="previewCta" class="primary has-ripple" bindtap="preview" bindtouchstart="ripple" disabled="{{!view.complete}}"><view wx:for="{{ripples}}" wx:key="id" class="ripple" style="left: {{item.left}}px; top: {{item.top}}px;"></view><text>预览与分享 →</text></button></view>
  <view class="end-note">{{view.complete ? '调整会自动保留为草稿；点“保存行程”存入我的。' : '为每一天加入地点后，即可保存和分享。'}}</view>
  <view wx:if="{{undoOpen}}" class="snackbar" catchtap="noop">
    <text class="snackbar-text">{{undoText}}</text>
    <button class="snackbar-action" bindtap="undoRemove" hover-class="pressed">撤销</button>
    <button class="snackbar-close" bindtap="dismissUndo" aria-label="关闭提示">×</button>
  </view>
</view>
<view wx:if="{{pickerOpen}}" class="sheet-mask" bindtap="closePicker" catchtouchmove="noop"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="section-head"><view><view class="section-title">{{replaceIndex === null ? '第 ' + (pickerDay + 1) + ' 天 · 添加地点' : '替换这一站'}}</view><view class="small muted">已在行程中的地点不重复添加</view></view><button class="sheet-close" bindtap="closePicker" aria-label="关闭选择地点">×</button></view><view class="picker-search"><text>⌕</text><input value="{{pickerQuery}}" placeholder="搜景点、区县或类别" bindinput="searchCandidates" confirm-type="search" /><button wx:if="{{pickerQuery}}" bindtap="clearSearch" aria-label="清空搜索">×</button></view><scroll-view scroll-x class="region-scroll" show-scrollbar="{{false}}"><view class="region-chips"><button wx:for="{{regions}}" wx:key="*this" class="region-chip {{pickerRegion === item ? 'active' : ''}}" data-region="{{item}}" bindtap="region">{{item}}</button></view></scroll-view><view class="picker-count">{{candidates.length}} 个地点可选</view><scroll-view scroll-y class="sheet-list"><button wx:for="{{candidates}}" wx:key="id" class="candidate" data-id="{{item.id}}" bindtap="choose" hover-class="pressed"><image wx:if="{{item.photo && !failedPhotos[item.id]}}" class="candidate-photo" src="{{item.photo}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="photoError" /><view wx:else class="candidate-photo photo-placeholder">{{item.mark}}</view><view class="grow"><view class="place-name">{{item.name}}</view><view class="small muted">{{item.region}} · {{item.durationText}}</view></view><text class="candidate-add">＋</text></button><view wx:if="{{!candidates.length}}" class="empty"><view class="empty-title">没有匹配的地点</view><view class="small muted">换个关键词或区县试试，已安排的地点会被隐藏。</view><button class="link" bindtap="clearSearch">重置筛选</button></view></scroll-view></view></view>
