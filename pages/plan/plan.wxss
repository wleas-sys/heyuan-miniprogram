.rec-photo{width:100%;height:100%;display:block}
.rec-photo-placeholder{display:flex;align-items:center;justify-content:center;height:100%;color:#7C917E;font-family:serif;font-size:56rpx;background:#E9EEE5}
.rec-cover-shade{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.4) 0%,rgba(0,0,0,0) 45%,rgba(0,0,0,.2) 100%);pointer-events:none}
.rec-cover-top{position:absolute;top:16rpx;left:18rpx;right:18rpx;display:flex;align-items:center;justify-content:space-between;z-index:2;pointer-events:none}
.rec-badge{background:#173F35;color:#fff;font-size:20rpx;font-weight:600;padding:6rpx 16rpx;border-radius:12rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.25)}
.rec-days-tag{background:rgba(0,0,0,.55);backdrop-filter:blur(6px);color:#fff;font-size:20rpx;padding:6rpx 16rpx;border-radius:12rpx;border:1rpx solid rgba(255,255,255,.25)}
.rec-info{padding:24rpx 26rpx;display:flex;flex-direction:column}
.rec-card-title{font-size:32rpx;font-weight:700;color:#173F35;line-height:1.4;margin-bottom:10rpx}
.rec-subtitle{font-size:23rpx;color:#607867;line-height:1.5;margin-bottom:14rpx}
.rec-days-flow{display:flex;flex-direction:column;gap:10rpx;margin:8rpx 0 16rpx;padding:16rpx 20rpx;background:#F4F7F2;border-radius:16rpx;border:1rpx solid #E3ECE0}
.rec-day-line{display:flex;align-items:flex-start;gap:12rpx;font-size:23rpx;line-height:1.5}
.rec-day-tag{background:#173F35;color:#fff;font-size:19rpx;padding:2rpx 12rpx;border-radius:8rpx;flex-shrink:0;font-weight:600;margin-top:2rpx}
