/* 交互补充：弹层滑入、新站点高亮 */
.sheet-mask{animation:mask-in .2s ease-out both}
.sheet{animation:sheet-up .26s cubic-bezier(.22,.9,.3,1) both}
@keyframes mask-in{from{background:rgba(13,34,25,0)}to{background:rgba(13,34,25,.48)}}
@keyframes sheet-up{from{transform:translateY(64rpx);opacity:.5}to{transform:translateY(0);opacity:1}}
@keyframes stop-pop{0%{box-shadow:0 0 0 0 rgba(96,142,101,.55)}55%{box-shadow:0 0 0 6rpx rgba(96,142,101,.28)}100%{box-shadow:0 0 0 0 rgba(96,142,101,0)}}
.stop.just-added{animation:stop-pop 1.1s ease-out}
/* 站点调整区展开时淡入，避免内容突然撑开 */
.stop-timing,.inside-break{animation:fold-in .2s ease-out both}
@keyframes fold-in{from{opacity:0;transform:translateY(-6rpx)}to{opacity:1;transform:none}}

/* 液态滑块：轨道、滑钮、日数同一条缓动；移动中先横向拉长 */
.segmented{position:relative;padding:5rpx;gap:0}
.segmented-track{position:relative;display:flex;width:100%}
.segmented-thumb{position:absolute;top:0;bottom:0;width:20%;border-radius:12rpx;background:#fff;box-shadow:0 2rpx 9rpx rgba(23,63,53,.08);transition:left .28s cubic-bezier(.22,1,.36,1),transform .28s cubic-bezier(.22,1,.36,1);z-index:0}
.segmented-thumb.liquid{transform:scaleX(1.12)}
.segmented button{position:relative;z-index:1;background:transparent!important;box-shadow:none!important}
.segmented button.selected{background:transparent!important;box-shadow:none!important}

/* 单一元件形变：⌄/⌃ 不再换字形，而是同一枚箭头转 180°，位置不丢 */
.fold-trigger{display:inline-flex;align-items:center;justify-content:flex-end;gap:8rpx}
.fold-chevron{width:11rpx;height:11rpx;border-right:3rpx solid currentColor;border-bottom:3rpx solid currentColor;transform:rotate(45deg);transition:transform .26s cubic-bezier(.34,1.4,.64,1);flex-shrink:0;margin:4rpx 2rpx 0 6rpx}
.fold-chevron.open{transform:rotate(-135deg);margin-top:-4rpx}

/* 成功勾选：对勾分两笔画出，先短后长 */
.check-box{position:relative}
.check-stroke{position:absolute;background:#fff;border-radius:2rpx;opacity:0;transform-origin:bottom center}
.stroke-a{width:3rpx;height:11rpx;left:16rpx;top:16rpx;transform:rotate(45deg) scaleY(0)}
.stroke-b{width:3rpx;height:20rpx;left:17rpx;top:8rpx;transform:rotate(-45deg) scaleY(0)}
.check-item.checked .stroke-a{opacity:1;animation:draw-a .18s ease-out both}
.check-item.checked .stroke-b{opacity:1;animation:draw-b .22s .13s ease-out both}
@keyframes draw-a{from{opacity:1;transform:rotate(45deg) scaleY(0)}to{opacity:1;transform:rotate(45deg) scaleY(1)}}
@keyframes draw-b{from{opacity:1;transform:rotate(-45deg) scaleY(0)}to{opacity:1;transform:rotate(-45deg) scaleY(1)}}

/* 卡片抽走：上层先移开，露出下面的时间线，再由数据真正删除 */
.stop.leaving{animation:card-out .17s ease-in forwards;pointer-events:none}
@keyframes card-out{from{opacity:1;transform:none}to{opacity:0;transform:translateX(-26rpx) scale(.97)}}

/* 底部抽屉：上升后在落位处停一拍，让用户看清状态再收尾 */
@keyframes sheet-up{0%{transform:translateY(100%)}55%{transform:translateY(-8rpx)}70%{transform:translateY(-8rpx)}86%{transform:translateY(0)}100%{transform:translateY(0)}}
.cost-unit{display:flex;align-items:center;gap:2rpx}
.cost-summary .fold-chevron{margin-left:6rpx}
.check-count .fold-chevron{margin-left:4rpx;margin-top:2rpx}

/* ---- 质感层：行程页 ---- */
.planner-page .title{letter-spacing:-1.4rpx}
.new-plan{background:linear-gradient(180deg,#EFF3EB,#E7EEE2);border:1rpx solid var(--hairline);box-shadow:var(--shadow-sm)}
.setup-card{border-color:var(--hairline);box-shadow:var(--shadow-sm)}
.day-tab{border-color:#E4E8DD;background:var(--card);box-shadow:0 1rpx 2rpx rgba(24,45,34,.03)}
.day-tab.active{background:linear-gradient(180deg,#1F4C3E,#143A2F);border-color:transparent;box-shadow:0 6rpx 16rpx rgba(20,58,47,.18)}
.stop.card{border-color:var(--hairline);box-shadow:var(--shadow-sm)}
.stop-actions{background:#FCFDF9}
.add-stop{border-color:#B9CBB4;background:#F1F4EC}
.transport-option.selected{background:#EDF2E7;border-color:#B9CEB4}
.sheet{box-shadow:0 -16rpx 60rpx rgba(13,34,25,.14)}

/* ===== 纸墨编辑风 · 行程 ===== */
.planner-page .title{font-family:var(--serif);font-size:50rpx;letter-spacing:1rpx;line-height:1.25}
.new-plan{border-radius:2rpx;border:1rpx solid var(--line-strong);background:transparent;box-shadow:none;font-family:var(--serif)}
.setup-card{border-radius:2rpx;border:1rpx solid var(--line);box-shadow:none}
.title-field{font-family:var(--serif);letter-spacing:.5rpx}
.setup-divider{background:var(--line)}
.day-tab{border-radius:2rpx;border:1rpx solid var(--line);background:transparent;box-shadow:none}
.day-tab.active{background:var(--green);border-color:var(--green);box-shadow:none}
.day-count{letter-spacing:1rpx}
.segmented{border-radius:2rpx;background:var(--paper-2)}
.segmented-thumb{border-radius:1rpx;background:var(--card);box-shadow:none}
.transport-option{border-radius:2rpx;border-color:var(--line)}
.transport-option.selected{background:var(--paper-2);border-color:var(--line-strong);color:var(--ink)}
.stop.card{border-radius:2rpx;box-shadow:none;border:1rpx solid var(--line)}
.stop-number{border-radius:2rpx;background:var(--paper-2);color:var(--seal);font-family:var(--serif)}
.stop-photo{border-radius:2rpx}
.stop .place-name{font-family:var(--serif);font-size:29rpx}
.stop-actions{border-top-color:var(--line);background:transparent}
.add-stop{border-radius:2rpx;border:1rpx dashed var(--line-strong);background:transparent}
.check-box{border-radius:2rpx;border-color:var(--line-strong)}
.check-item.checked .check-box{background:var(--seal);border-color:var(--seal)}
.check-count{border-radius:2rpx;background:transparent;border:1rpx solid var(--line);font-family:var(--serif);color:var(--ink-2);flex-shrink:0}
.sheet{border-radius:0;background:var(--paper);box-shadow:none;border-top:1rpx solid var(--line-strong)}
.sheet-handle{border-radius:0;background:var(--line-strong)}
.sheet-close{border-radius:2rpx;background:transparent;border:1rpx solid var(--line);color:var(--ink-2)}
.picker-search{border-radius:2rpx;border-color:var(--line-strong);background:transparent}
.candidate-photo{border-radius:2rpx}
.candidate-add{border-radius:2rpx;background:var(--paper-2);border:1rpx solid var(--line);color:var(--ink)}
.budget-panel,.departure-panel{border-radius:2rpx}
.cost-value{font-family:var(--serif);color:var(--seal)}
.snackbar{border-radius:2rpx;background:var(--green);box-shadow:none}

/* ===== 清单：背景填充表示进度，勾满提亮 ===== */
.departure-panel{position:relative;overflow:hidden}
.check-fill{position:absolute;left:0;top:0;bottom:0;width:0;background:rgba(23,59,44,.055);transition:width .52s cubic-bezier(.22,1,.36,1);z-index:0;pointer-events:none}
.check-body{position:relative;z-index:1}
.departure-panel.complete .check-fill{background:rgba(166,64,44,.075)}
.departure-panel.complete{animation:check-glow .9s ease-out}
@keyframes check-glow{0%{background:var(--card)}32%{background:#FFF8EA}100%{background:var(--card)}}

/* ===== 预算：深色托盘，明细向下展开 ===== */
.budget-tray{padding:9rpx;background:#1B211C;border-radius:2rpx}
.budget-tray-body{background:var(--card)}
.budget-tray .panel-toggle{padding:24rpx}
.budget-tray .budget-detail{animation:tray-open .32s cubic-bezier(.22,.9,.3,1) both}
@keyframes tray-open{from{opacity:0;transform:translateY(-12rpx)}to{opacity:1;transform:none}}
