.rec-intro{font-size:24rpx;color:#45604C;line-height:1.65;margin-bottom:18rpx}
.rec-apply-btn{width:100%!important;background:#173F35!important;color:#fff!important;font-size:26rpx!important;padding:18rpx!important;border-radius:16rpx!important;margin-top:4rpx;font-weight:600}
.rec-shortcut-banner{display:flex;justify-content:space-between;align-items:center;padding:18rpx 24rpx;background:#EBF2E7;border:1rpx solid #D5E2D0;border-radius:18rpx;margin-bottom:22rpx;font-size:24rpx;color:#355C41}
.rec-shortcut-banner .arrow{font-size:26rpx;color:#173F35;font-weight:bold}

.days-setting{display:block}.days-setting>.field-label{display:block;margin-bottom:18rpx}.days-setting .segmented{display:flex;width:100%;box-sizing:border-box}.days-setting .segmented button{flex:1;min-width:0;padding:14rpx 0}.day-tabs{gap:10rpx}.day-tab{min-width:0}.day-count{display:none}.stop-adjust-heading{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #E5EBE1;padding:16rpx 20rpx;color:#748279;font-size:22rpx}.stop-adjust-heading button{color:#173F35;padding:12rpx 0;font-size:24rpx}.departure-toggle{width:100%!important;text-align:left}.ticket-name{flex:1}.ticket-reference{font-size:21rpx;color:#748279;line-height:1.7;margin-top:8rpx}.ticket-reference .link{font-size:21rpx}.cost-value{font-size:32rpx!important}.cost-summary{flex-shrink:0}.panel-toggle{gap:18rpx}.budget-caption{line-height:1.8}

