.rec-banner-card{padding:26rpx 28rpx;background:linear-gradient(135deg,#173F35 0%,#285343 100%);color:#fff;border-radius:24rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(23,63,53,.15)}
