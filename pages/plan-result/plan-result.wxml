<view wx:if="{{singlePage}}" class="timeline-notice">正在预览分享内容。保存、编辑或查看更多，请点击微信底部的“前往小程序”。</view>
<view wx:if="{{view}}" class="page with-dock result-page">
  <view class="result-heading"><image wx:if="{{heroPhoto && !failedPhotos[heroId]}}" class="hero-image" src="{{heroPhoto}}" mode="aspectFill" data-id="{{heroId}}" binderror="photoError" /><view class="hero-shade"></view><view class="hero-content"><view class="between"><text class="eyebrow">万绿智游 · 行程手册</text><text class="origin-label">{{shared ? '来自朋友分享' : '我的行程'}}</text></view><view class="title">{{view.plan.title}}</view><view class="hero-facts"><view><text class="fact-value">{{view.days.length}}</text><text>天</text></view><view><text class="fact-value">{{view.count}}</text><text>站</text></view><view class="transport-fact">{{view.modeLabel}}</view></view></view></view>
  <view class="trip-date">{{view.dateLabel}}<text>每天 {{view.days[0].startText}} 从首站开始</text></view>
  <view class="travel-note"><text class="note-mark">i</text><text>以下为计划时间，按停留、路上预留和休息推算。不含出发地到首站、末站返回住处及跨日交通，也不是实时导航；出发前请核对开放与交通。</text></view>
  <view class="result-days"><button wx:for="{{view.days}}" wx:key="day" class="result-day-tab {{activeDay === item.index ? 'active' : ''}}" data-day="{{item.index}}" bindtap="selectDay"><text>第 {{item.day}} 天</text><text class="day-stops">{{item.places.length}} 个地点</text></button></view>
  <block wx:for="{{view.days}}" wx:for-item="day" wx:key="day">
    <view wx:if="{{activeDay === day.index}}">
      <view class="day-overview card"><view class="between"><text>{{day.dateLabel}}</text><text class="schedule-finish">{{day.startText}}–{{day.finishText}}</text></view><view class="time-totals">游览 {{day.visitDurationText}} · 路上 {{day.travelDurationText}}<text wx:if="{{day.breakMinutes}}"> · 休息 {{day.breakDurationText}}</text></view><view wx:if="{{day.overflowMinutes}}" class="schedule-alert">比期望 {{day.endText}} 晚 {{day.overflowDurationText}}，建议删减地点或缩短停留。</view><view wx:if="{{day.missingTransfers}}" class="transfer-pending">{{day.missingTransfers}} 段交通仍使用预留时间，需到地图核对。</view></view>
      <block wx:for="{{day.places}}" wx:for-item="place" wx:key="id">
        <view wx:if="{{place.travelKey}}" class="journey-gap"><text class="gap-line"></text><view>路上 {{place.travelBefore}} 分钟<text>{{place.travelConfirmed ? '自行填写 · 出发前再核对' : '预留时间 · 尚未核对'}}</text></view></view>
        <view wx:if="{{place.breakBefore}}" class="rest-block">用餐 / 休息 · {{place.breakBefore}} 分钟</view>
        <view class="result-stop"><view class="result-rail"><text class="stop-index">{{place.order}}</text><view wx:if="{{place.canDown}}" class="rail-line"></view></view><view class="card result-place"><view class="schedule-slot"><text>{{place.arriveText}}–{{place.leaveText}}</text><text>计划停留 {{place.visitDurationText}}</text></view><view class="result-place-main" data-id="{{place.id}}" bindtap="detail" hover-class="pressed"><image wx:if="{{place.photo && !failedPhotos[place.id]}}" class="result-photo" src="{{place.photo}}" mode="aspectFill" lazy-load data-id="{{place.id}}" binderror="photoError" /><view wx:else class="result-photo photo-placeholder">{{place.mark}}</view><view class="grow"><text class="place-region">{{place.region}} · {{place.category}}</text><view class="place-name">{{place.name}}</view></view><text class="detail-arrow">›</text></view><view wx:if="{{place.breakDuring}}" class="inside-rest">其中 {{place.breakStartText}}–{{place.breakEndText}} 用餐 / 休息 {{place.breakDuring}} 分钟，游览时间另计</view><view class="place-info"><view class="address">{{place.address}}</view><view class="hours">{{place.hoursText}}</view></view><view class="place-footer"><text class="ticket-status">{{place.ticketInput === '' ? '门票待确认' : '已记门票 ¥' + place.ticketInput + '/人'}}</text><button class="map-button" data-id="{{place.id}}" bindtap="navigate">{{place.map ? '查看位置 ↗' : '复制地址 ↗'}}</button></view></view></view>
      </block>
      <block wx:for="{{day.breaks}}" wx:key="startText"><view wx:if="{{!item.beforePlaceId && !item.insidePlaceId}}" class="rest-block">{{item.startText}}–{{item.endText}} 用餐 / 休息</view></block>
      <view wx:for="{{day.notes}}" wx:key="*this" class="notice day-note">{{item}}</view>
    </view>
  </block>
  <view class="section card result-budget"><button class="budget-heading" bindtap="toggleBudget"><view><view class="section-title">参考预算</view><view class="small muted">{{view.estimate.caption}} · 按人均计算</view></view><view class="budget-value">{{view.estimate.text}}<text>{{budgetOpen ? '⌃' : '⌄'}}</text></view></button><view wx:if="{{budgetOpen}}" class="fee-detail"><view wx:for="{{view.estimate.living}}" wx:key="label" class="between fee"><text class="muted">{{item.label}}</text><text>¥{{item.low}}{{item.high !== item.low ? '–' + item.high : ''}}{{item.unknown ? '（未计入）' : ''}}</text></view><view class="small muted">门票：有依据的参考金额与自填金额已计入；其他门票待核对。</view><view wx:if="{{view.plan.budget !== null}}" class="budget-total">总预算：¥{{view.plan.budget}} / 人</view><view class="fee-caption">{{view.estimate.assumptions}}</view><view wx:for="{{view.warnings}}" wx:key="*this" class="notice day-note">{{item}}</view></view><view wx:if="{{!budgetOpen && view.plan.budget !== null && view.subtotal > view.plan.budget}}" class="budget-over">已填费用超出预算 ¥{{view.subtotal - view.plan.budget}}</view></view>
  <view wx:if="{{!singlePage}}" class="section two-col extra-actions"><button class="secondary" bindtap="edit">{{shared ? '调整成我的行程' : '继续编辑'}}</button><button class="secondary" bindtap="copy">复制文字安排</button></view>
  <view class="end-note">{{shared ? '先保存到本机，下次可在“我的”找到这份行程。' : '分享会带上出发日期、时间安排和已填费用。'}}<view>车船班次、开放、用餐条件与预订请自行确认。</view></view>
  <view wx:if="{{!singlePage}}" class="dock"><button class="secondary" bindtap="save">{{saved ? '已保存 ✓' : '保存到我的'}}</button><button class="primary" open-type="share">分享给朋友 ↗</button></view>
</view>
<view wx:else class="page error-page"><view class="empty"><view class="error-symbol">↗</view><view class="empty-title">这份行程暂时打不开</view><view class="small muted">{{error || '请返回后重新打开。'}}</view><button class="primary" bindtap="home">回到首页</button></view></view>
