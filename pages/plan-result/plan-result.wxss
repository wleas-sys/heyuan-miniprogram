.result-heading{position:relative;min-height:348rpx;border-radius:30rpx;background:#173F35;overflow:hidden;color:#fff}.hero-image{position:absolute;inset:0;width:100%;height:100%}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,35,26,.24),rgba(10,35,26,.8))}.hero-content{position:relative;padding:30rpx;min-height:348rpx;display:flex;flex-direction:column;justify-content:space-between}.hero-content .eyebrow{font-size:22rpx;color:#E4EFE0;letter-spacing:2rpx}.origin-label{font-size:22rpx;color:#EDF3E8;background:rgba(255,255,255,.15);border:1rpx solid rgba(255,255,255,.2);padding:5rpx 12rpx;border-radius:20rpx;white-space:nowrap}.hero-content .title{font-size:44rpx;line-height:1.4;margin:42rpx 0 28rpx;overflow-wrap:break-word;font-weight:600}.hero-facts{display:flex;align-items:center;gap:30rpx;font-size:23rpx;color:#E8F0E4}.hero-facts>view{display:flex;align-items:baseline;gap:8rpx}.fact-value{font-family:Georgia,serif;font-size:40rpx;line-height:1}.transport-fact{border-left:1rpx solid rgba(255,255,255,.3);padding-left:26rpx;font-size:24rpx}.travel-note{display:flex;align-items:flex-start;gap:14rpx;margin:24rpx 0 30rpx;font-size:23rpx;color:#55625A;line-height:1.7}.note-mark{width:29rpx;height:29rpx;line-height:27rpx;text-align:center;border:1rpx solid #A9BAA3;border-radius:50%;font-family:Georgia,serif;flex-shrink:0;margin-top:4rpx;font-size:22rpx;color:#55625A}.result-days{display:flex;gap:14rpx}.result-day-tab{display:flex;gap:18rpx;align-items:center;min-height:84rpx;padding:17rpx 23rpx;border:1rpx solid #DFE7DA;background:#fff;border-radius:20rpx;font-size:26rpx;color:#55625A}.result-day-tab.active{background:#173F35;color:#fff;border-color:#173B2C}.day-stops{font-size:22rpx;opacity:.7}.duration-label{font-size:22rpx;color:#55625A;margin:18rpx 0 24rpx}.result-stop{display:flex;gap:16rpx;margin-bottom:20rpx}.result-rail{display:flex;flex-direction:column;align-items:center;width:38rpx;flex-shrink:0;padding-top:26rpx}.stop-index{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:50%;background:#DDE9D6;color:#55625A;font-size:22rpx;font-weight:600}.rail-line{width:2rpx;flex:1;min-height:80rpx;background:#D8E2D2;margin:12rpx 0 -30rpx}.result-place.card{flex:1;min-width:0;padding:0;border-radius:24rpx;overflow:hidden}.result-place-main{display:flex;align-items:center;gap:18rpx;padding:20rpx}.result-photo{display:block;width:128rpx;height:140rpx;border-radius:16rpx;flex-shrink:0;background:#E8EEE3}.photo-placeholder{display:flex;align-items:center;justify-content:center;font-family:serif;font-size:44rpx;color:#55625A}.place-region{font-size:22rpx;color:#55625A}.result-place .place-name{font-size:29rpx;line-height:1.35;margin:6rpx 0 9rpx}.stay-time{font-size:22rpx;line-height:1.6;color:#55625A}.detail-arrow{font-size:30rpx;color:#55625A;flex-shrink:0}.place-info{padding:0 20rpx 20rpx}.address{font-size:24rpx;color:#55625A;line-height:1.65}.hours{font-size:22rpx;color:#55625A;margin-top:8rpx;line-height:1.7}.place-footer{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:0 20rpx;background:#FAFCF7;border-top:1rpx solid #E6ECE0;min-height:80rpx}.ticket-status{font-size:22rpx;color:#55625A}.map-button{font-size:24rpx;color:#55625A;min-height:80rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.day-note{margin-top:18rpx;font-size:23rpx!important}.result-budget{padding:0;overflow:hidden}.budget-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:26rpx;width:100%!important;text-align:left}.budget-heading .section-title{font-size:30rpx}.budget-heading .small{font-size:22rpx;margin-top:6rpx}.budget-value{font-family:Georgia,serif;font-size:42rpx;color:#173B2C;white-space:nowrap}.budget-value text{font-family:inherit;font-size:27rpx;color:#55625A;margin-left:16rpx}.fee-detail{padding:0 26rpx 26rpx}.fee{font-size:24rpx;padding:18rpx 0;border-top:1rpx solid #D8D2C0}.budget-total{font-size:24rpx;color:#55625A;margin-top:20rpx}.fee-caption{font-size:22rpx;color:#55625A;margin-top:16rpx}.fee-detail .notice{font-size:22rpx;padding:16rpx 18rpx}.budget-over{padding:0 26rpx 22rpx;color:#8E4433;font-size:23rpx}.extra-actions button{font-size:24rpx}.result-page .dock button{font-size:26rpx}.result-page .end-note{margin-top:26rpx}.error-page{padding-top:80rpx}.error-symbol{font-family:Georgia,serif;font-size:58rpx;color:#55625A;margin-bottom:20rpx}
