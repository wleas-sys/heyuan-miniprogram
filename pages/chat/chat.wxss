/* 对话页：iOS 消息式的左 AI / 右用户气泡，底部固定输入区，整体沿用全局的墨绿 + 米白配色 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
  overflow: hidden;
}

.chat-scroll { flex: 1; min-height: 0; }
.chat-inner { padding: 28rpx 28rpx 20rpx; }

/* 单条消息 */
.msg { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 26rpx; }
.msg.user { flex-direction: row-reverse; }

.avatar {
  width: 64rpx; height: 64rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--green); color: #fff;
  font-size: 26rpx; font-weight: 600;
}

.bubble {
  max-width: 78%;
  padding: 22rpx 26rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 10rpx 26rpx 26rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(23, 63, 53, .04);
}
/* 带方案卡片时让气泡撑满，卡片才有横向空间 */
.bubble.has-cards { max-width: 100%; flex: 1; }

.msg.user .bubble {
  background: var(--green);
  border-color: var(--green);
  border-radius: 26rpx 10rpx 26rpx 26rpx;
}

.bubble-text { font-size: 27rpx; line-height: 1.78; word-break: break-word; }
.msg.user .bubble-text { color: #fff; }

/* 输入中的三点动画 */
.typing { display: flex; align-items: center; gap: 10rpx; padding: 28rpx 26rpx; }
.typing-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #B4C4B7;
  animation: typing-bounce 1.2s infinite ease-in-out;
}
.typing-dot:nth-child(2) { animation-delay: .18s; }
.typing-dot:nth-child(3) { animation-delay: .36s; }
@keyframes typing-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: .5; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* 方案卡片 */
.cards { margin-top: 20rpx; display: flex; flex-direction: column; gap: 18rpx; }
.plan-card {
  padding: 22rpx;
  background: #F8FAF6;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
}
.plan-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.plan-title { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 650; line-height: 1.5; }
.plan-score { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; color: var(--green); font-size: 27rpx; font-weight: 650; }
.plan-score-unit { font-size: 18rpx; font-weight: 400; color: var(--muted); }
.plan-meta { margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
.plan-days { margin-top: 14rpx; display: flex; flex-direction: column; gap: 8rpx; }
.plan-day { display: flex; gap: 12rpx; font-size: 23rpx; line-height: 1.7; }
.plan-day-label { flex-shrink: 0; color: var(--green); }
.plan-day-names { color: #48604F; word-break: break-word; }
.plan-reason { margin-top: 14rpx; font-size: 22rpx; line-height: 1.7; color: var(--muted); }
.plan-use {
  margin-top: 20rpx; width: 100%;
  padding: 18rpx;
  background: var(--green); color: #fff;
  border-radius: 16rpx; font-size: 26rpx; text-align: center;
}

/* 快捷短语 */
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; padding: 0 28rpx 16rpx; }
.chip {
  padding: 14rpx 26rpx;
  background: #fff; border: 1rpx solid var(--line); border-radius: 40rpx;
  font-size: 25rpx; color: var(--green);
}
.chip-pressed { background: var(--soft); }

/* 底部输入 */
.composer {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .95);
  border-top: 1rpx solid var(--line);
}
.composer-input {
  flex: 1; min-width: 0; height: 84rpx;
  padding: 0 28rpx;
  background: #F1F4EE;
  border-radius: 42rpx;
  font-size: 27rpx;
}
.composer-ph { color: #9AA89D; }
.composer-send {
  flex-shrink: 0; width: 132rpx; height: 84rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--green); color: #fff;
  border-radius: 42rpx; font-size: 27rpx;
}

.preview-notice {
  padding: 18rpx 28rpx;
  background: #F0EDE3; color: #776C52;
  font-size: 23rpx; text-align: center;
}

/* 交互补充：顶部状态条、重开入口、消息入场 */
.chat-top {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 28rpx;
  background: var(--paper);
  border-bottom: 1rpx solid var(--line);
}
.chat-top-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; }
.chat-top-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #7FA37F; flex-shrink: 0; }
.chat-top-text { font-size: 22rpx; color: #5E7365; line-height: 1.5; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.chat-reset {
  flex-shrink: 0; min-height: 56rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid #D6E2D1; border-radius: 28rpx;
  background: #fff; color: #4B6A51; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}

.msg { animation: msg-in .24s cubic-bezier(.22,.9,.3,1) both; }
@keyframes msg-in { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }

.composer-send { transition: transform .14s ease, opacity .18s ease, background-color .2s ease; }
.composer-send[disabled] { background: #C3D1C4; color: #F4F7F1; opacity: 1; }
.send-pressed { transform: scale(.96); opacity: .9; }

/* ---- 质感层：气泡、卡片、输入区 ---- */
.bubble{background:var(--card);border-color:rgba(26,50,38,.07);box-shadow:var(--shadow-sm);border-radius:10rpx 26rpx 26rpx 26rpx}
.msg.user .bubble{background:linear-gradient(180deg,#1F4C3E,#143A2F);border-color:transparent;box-shadow:0 4rpx 14rpx rgba(20,58,47,.16)}
.avatar{background:linear-gradient(160deg,#245144,#143A2F);box-shadow:0 3rpx 8rpx rgba(20,58,47,.18)}
.plan-card{background:#FBFCF7;border-color:rgba(26,50,38,.06);border-radius:22rpx}
.plan-use{background:linear-gradient(180deg,#1F4C3E,#143A2F);box-shadow:0 6rpx 16rpx rgba(20,58,47,.16);border-radius:16rpx}
.chip{background:var(--card);border-color:#E3E7DC;box-shadow:0 1rpx 2rpx rgba(24,45,34,.03)}
.composer{background:rgba(255,254,251,.96);backdrop-filter:blur(16px);border-top-color:var(--hairline)}
.composer-input{background:#F2F4EE;border:1rpx solid rgba(26,50,38,.05)}
.composer-send{background:linear-gradient(180deg,#1F4C3E,#143A2F);box-shadow:0 4rpx 12rpx rgba(20,58,47,.18)}
.chat-top{background:rgba(247,246,241,.96);border-bottom-color:var(--hairline)}
.chat-reset{border-color:#E1E6DA;background:var(--card);box-shadow:0 1rpx 2rpx rgba(24,45,34,.03)}

/* ===== 纸墨编辑风 · 对话 ===== */
.chat-page{background:var(--paper)}
.chat-top{background:var(--paper);border-bottom:1rpx solid var(--line);padding:16rpx 28rpx}
.chat-top-text{font-size:20rpx;letter-spacing:.5rpx;color:var(--muted)}
.chat-top-dot{background:var(--seal);border-radius:0;width:10rpx;height:10rpx}
.chat-reset{border-radius:2rpx;border:1rpx solid var(--line-strong);background:transparent;box-shadow:none;font-size:20rpx;letter-spacing:1rpx;min-height:52rpx}
.bubble{border-radius:0 8rpx 8rpx 8rpx;background:var(--card);border:1rpx solid var(--line);box-shadow:none}
.msg.user .bubble{border-radius:8rpx 0 8rpx 8rpx;background:var(--green);border-color:var(--green)}
.bubble-text{font-size:26rpx;line-height:1.8}
.avatar{border-radius:2rpx;background:var(--seal);box-shadow:none;font-family:var(--serif)}
.plan-card{border-radius:2rpx;border:1rpx solid var(--line);background:transparent}
.plan-title{font-family:var(--serif);font-size:30rpx;letter-spacing:.3rpx}
.plan-score{color:var(--seal)}
.plan-use{border-radius:2rpx;background:var(--green);box-shadow:none;letter-spacing:1.5rpx}
.chip{border-radius:2rpx;border:1rpx solid var(--line-strong);background:transparent;box-shadow:none;font-size:23rpx;letter-spacing:.5rpx;color:var(--ink-2)}
.composer{background:var(--paper);border-top:1rpx solid var(--line);backdrop-filter:none}
.composer-input{background:transparent;border:1rpx solid var(--line-strong);border-radius:2rpx}
.composer-send{border-radius:2rpx;background:var(--green);box-shadow:none;letter-spacing:2rpx}
.composer-send[disabled]{background:var(--line-strong);color:var(--paper)}
