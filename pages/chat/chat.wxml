<view class="chat-page">
  <view wx:if="{{singlePage}}" class="preview-notice">正在预览。生成与采用方案，请点击底部「前往小程序」。</view>
  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view class="chat-inner">
      <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="msg {{item.role}}">
        <view wx:if="{{item.role === 'ai'}}" class="avatar">智</view>
        <view class="bubble {{item.cards.length ? 'has-cards' : ''}}">
          <text class="bubble-text">{{item.text}}</text>

          <view wx:if="{{item.cards.length}}" class="cards">
            <view wx:for="{{item.cards}}" wx:key="id" wx:for-item="card" class="plan-card">
              <view class="plan-head">
                <text class="plan-title">{{card.title}}</text>
                <view class="plan-score"><text>{{card.scoreText}}</text><text class="plan-score-unit">匹配</text></view>
              </view>
              <view class="plan-meta">{{form.days}} 天 · {{card.stopCount}} 个地点 · 参考 {{card.estimateText}}</view>
              <view class="plan-days">
                <view wx:for="{{card.days}}" wx:key="label" wx:for-item="day" class="plan-day">
                  <text class="plan-day-label">{{day.label}}</text>
                  <text class="plan-day-names">{{day.names}}</text>
                </view>
              </view>
              <view class="plan-reason">{{card.reason}}</view>
              <button class="plan-use" data-id="{{card.id}}" bindtap="use" disabled="{{adopting}}">用这个方案 →</button>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{busy}}" class="msg ai">
        <view class="avatar">智</view>
        <view class="bubble typing"><view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view></view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{chips.length && !busy}}" class="chips">
    <view wx:for="{{chips}}" wx:key="*this" class="chip" data-text="{{item}}" bindtap="tapChip" hover-class="chip-pressed">{{item}}</view>
  </view>

  <view class="composer">
    <input class="composer-input" value="{{input}}" bindinput="onInput" bindconfirm="submit" confirm-type="send" maxlength="60" placeholder="说一句，比如「两天带爸妈看温泉」" placeholder-class="composer-ph" aria-label="说说你的出游想法"/>
    <button class="composer-send" bindtap="submit" disabled="{{busy}}" aria-label="发送">发送</button>
  </view>
</view>
