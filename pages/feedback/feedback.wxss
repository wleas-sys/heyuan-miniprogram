.feedback-heading{padding:22rpx 0 36rpx}.feedback-heading .title{font-size:44rpx;margin-top:12rpx}.feedback-heading .subtitle{font-size:25rpx;margin-top:14rpx;line-height:1.7}.feedback-main{padding:36rpx 30rpx 28rpx;margin:0}.feedback-symbol{width:78rpx;height:66rpx;border-radius:22rpx 22rpx 22rpx 7rpx;background:#E8EFE3;display:flex;align-items:center;justify-content:center;gap:8rpx;margin-bottom:24rpx}.feedback-symbol view{width:8rpx;height:8rpx;border-radius:50%;background:#577960}.feedback-title{font-size:34rpx;font-weight:650;color:#173F35}.channel-description{font-size:25rpx;color:#697C65;line-height:1.85;margin:14rpx 0 26rpx}.feedback-submit{display:flex;align-items:center;justify-content:space-between;width:100%!important;min-height:96rpx;padding:24rpx 28rpx;font-size:28rpx;border-radius:18rpx}.feedback-submit text{font-size:30rpx}.channel-hint{font-size:22rpx;color:#83917E;margin-top:18rpx;line-height:1.7}.feedback-reminder{font-size:22rpx;color:#5B7352;line-height:1.7;margin-top:12rpx}.feedback-context{background:#F1F5EB;border-radius:16rpx;padding:20rpx;margin-bottom:24rpx;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8rpx 12rpx}.context-label{font-size:24rpx;color:#476443;font-weight:600}.feedback-context .link{font-size:23rpx;padding:4rpx 0}.context-hint{font-size:21rpx;color:#83917C;flex-basis:100%}.feedback-help{margin-top:16rpx}.help-toggle,.history-toggle{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%!important;text-align:left;padding:24rpx 4rpx;color:#60775A;font-size:25rpx;min-height:88rpx}.help-toggle>text:last-child{flex-shrink:0;font-size:28rpx}.help-content{font-size:24rpx;line-height:1.85;color:#75836C;padding:0 4rpx 22rpx}.help-content>view+view{margin-top:14rpx}.feedback-secondary{border-top:1rpx solid #DDE6D5;border-bottom:1rpx solid #DDE6D5;margin-top:12rpx}.contact-title{font-size:27rpx;font-weight:600;color:#456240}.contact-subtitle{font-size:22rpx;color:#83917C;margin-top:7rpx}.contact-content{padding:0 4rpx 26rpx}.contact-content .channel-description{margin:0 0 20rpx}.channel-button{width:100%!important;min-height:88rpx}.feedback-footer{text-align:center;font-size:21rpx;color:#8B9785;line-height:1.8;margin:34rpx 0}.legacy-feedback{margin-top:28rpx;padding:10rpx 24rpx}.legacy-item{border-top:1rpx solid #E2E8DD;padding:18rpx 0}.history-content{font-size:25rpx;color:#4D644C;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere}.legacy-item .link{margin-top:12rpx}.legacy-feedback>.link{padding-bottom:18rpx}@media(max-width:350px){.feedback-main{padding:30rpx 26rpx}.feedback-heading .title{font-size:42rpx}}
