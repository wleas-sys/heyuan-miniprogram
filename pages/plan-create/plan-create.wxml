<view wx:if="{{singlePage}}" class="timeline-notice">正在预览。生成与采用方案，请点击底部“前往小程序”。</view>
<view class="page create-page">
  <view class="create-heading"><view class="eyebrow">安排一趟河源行程</view><view class="title">先说说，<text>你想怎么逛</text></view><view class="subtitle">选好时间与偏好，看看可调整的出游方案。</view></view>
  <view class="form-card">
    <view class="form-section first-section"><view class="form-title"><text class="form-step">01</text><text>留几天给河源</text></view>
      <view class="days-options days-options-multi">
        <button class="day-choice {{form.days === 1 ? 'selected' : ''}}" data-value="1" bindtap="chooseDays" aria-pressed="{{form.days === 1}}" disabled="{{singlePage || adopting}}"><text class="day-num">1 <text>天</text></text><text class="day-description">当天往返</text><view class="choice-dot"></view></button>
        <button class="day-choice {{form.days === 2 ? 'selected' : ''}}" data-value="2" bindtap="chooseDays" aria-pressed="{{form.days === 2}}" disabled="{{singlePage || adopting}}"><text class="day-num">2 <text>天</text></text><text class="day-description">周末微度假</text><view class="choice-dot"></view></button>
        <button class="day-choice {{form.days === 3 ? 'selected' : ''}}" data-value="3" bindtap="chooseDays" aria-pressed="{{form.days === 3}}" disabled="{{singlePage || adopting}}"><text class="day-num">3 <text>天</text></text><text class="day-description">小长假精选</text><view class="choice-dot"></view></button>
        <button class="day-choice {{form.days === 4 ? 'selected' : ''}}" data-value="4" bindtap="chooseDays" aria-pressed="{{form.days === 4}}" disabled="{{singlePage || adopting}}"><text class="day-num">4 <text>天</text></text><text class="day-description">多留一点时间</text><view class="choice-dot"></view></button>
        <button class="day-choice {{form.days === 5 ? 'selected' : ''}}" data-value="5" bindtap="chooseDays" aria-pressed="{{form.days === 5}}" disabled="{{singlePage || adopting}}"><text class="day-num">5 <text>天</text></text><text class="day-description">慢慢看河源</text><view class="choice-dot"></view></button>
      </view>
      <view class="date-row"><picker mode="date" value="{{form.date}}" bindchange="changeDate" disabled="{{singlePage || adopting}}" class="date-picker"><view class="date-value"><view><text class="date-label">出发日期 <text>选填</text></text><view class="date-text {{!form.date ? 'date-placeholder' : ''}}">{{form.date || '还没定，先做计划'}}</view></view><text class="chevron">›</text></view></picker><button wx:if="{{form.date}}" class="clear-date" bindtap="clearDate" disabled="{{singlePage || adopting}}" aria-label="清除出发日期">清除</button></view>
    </view>
    <view class="form-section"><view class="form-title"><text class="form-step">02</text><text>这趟怎么出行</text></view><view class="mode-options"><button wx:for="{{modes}}" wx:key="key" class="option {{form.mode === item.key ? 'selected' : ''}}" data-value="{{item.key}}" bindtap="chooseMode" aria-pressed="{{form.mode === item.key}}" disabled="{{singlePage || adopting}}">{{item.label}}</button></view><view class="form-help">{{form.mode === 'walk' ? '步行只安排恐龙博物馆与龟峰塔片区的一日游。' : form.mode === 'transit' ? '公共交通仅组合城区地点；班次与换乘需另查。' : '不含到达河源与返程的路程，请另外预留时间。'}}</view></view>
    <view class="form-section"><view class="form-title"><text class="form-step">03</text><text>喜欢什么节奏</text></view><view class="pace-options"><button wx:for="{{paces}}" wx:key="key" class="pace-choice {{form.pace === item.key ? 'selected' : ''}}" data-value="{{item.key}}" bindtap="choosePace" aria-pressed="{{form.pace === item.key}}" disabled="{{singlePage || adopting}}"><view class="pace-label">{{item.label}}</view><view class="pace-note">{{item.desc}}</view></button></view><view class="crowd-row"><view class="crowd-label">同行的人<text class="crowd-note">只调整推荐排序，不缩小可选地点</text></view><view class="crowd-options"><button wx:for="{{crowds}}" wx:key="key" class="crowd-choice {{form.crowd === item.key ? 'selected' : ''}}" data-value="{{item.key}}" bindtap="chooseCrowd" aria-pressed="{{form.crowd === item.key}}" disabled="{{singlePage || adopting}}">{{item.label}}</button></view></view></view>
    <view class="form-section"><view class="form-title"><text class="form-step">04</text><text>这次主要想看什么</text></view><view class="interest-options"><button wx:for="{{interests}}" wx:key="key" class="interest-choice {{form.interest === item.key ? 'selected' : ''}}" data-value="{{item.key}}" bindtap="chooseInterest" aria-pressed="{{form.interest === item.key}}" disabled="{{singlePage || adopting}}">{{item.label}}</button></view><view class="region-row"><view><view class="region-title">活动范围</view><view class="region-note">明确去哪一带，安排更集中</view></view><picker range="{{regions}}" value="{{regionIndex}}" bindchange="changeRegion" disabled="{{singlePage || adopting}}"><view class="region-picker">{{form.region === '全部' ? '全河源' : form.region}}<text>⌄</text></view></picker></view></view>
  </view>
  <view class="generate-area"><view wx:if="{{changed}}" class="changed-note">条件已调整，请重新生成方案。</view><view wx:if="{{error}}" class="error-note">{{error}}</view><button class="primary generate-button" bindtap="generate" disabled="{{singlePage || adopting}}">{{generated ? '重新生成方案' : '查看出游方案'}}<text>→</text></button><view class="generate-note">最多 3 个方案。查看方案不会替换当前草稿。</view></view>
  <view id="recommendations" class="recommendations" wx:if="{{generated}}">
    <view class="results-heading"><view class="eyebrow">按你的偏好整理</view><view class="section-title">{{results.length ? '选一个起点，再慢慢调整' : '这组条件暂时排不出合适方案'}}</view><view class="results-summary">{{selectedSummary}}</view></view>
    <view wx:if="{{!results.length}}" class="no-results"><view class="no-results-mark">↗</view><view class="no-results-title">给行程多一点选择</view><view class="no-results-copy">{{emptyMessage}}</view><button class="secondary" bindtap="relax">{{relaxLabel}}</button><button class="plain-link" bindtap="goEditor">自己安排行程 →</button></view>
    <view wx:for="{{results}}" wx:key="id" wx:for-item="result" class="result-card">
      <view class="result-cover"><image wx:if="{{result.coverPhoto && !result.imageFailed}}" src="{{result.coverPhoto}}" mode="aspectFill" class="result-photo" data-id="{{result.id}}" binderror="imageError" lazy-load/><view wx:else class="result-photo-fallback"><text>河源</text><text>把想去的地方，串成一次出发</text></view><view class="result-cover-shade"></view><view class="result-cover-meta"><text class="result-number">{{result.tag || ('方案 ' + result.number)}}</text><text class="result-count">{{form.days}} 天 · {{result.stopCount}} 个地点</text></view><view class="result-title">{{result.title}}</view></view>
      <view class="result-body"><view class="result-reason">{{result.reason}}</view><view wx:if="{{result.reasons.length}}" class="model-block"><view class="model-head"><view class="model-title">为什么推荐它</view><view class="model-score"><text class="model-score-value">{{result.scoreText}}</text><text class="model-score-unit">匹配分</text></view></view><view class="model-reasons"><view wx:for="{{result.reasons}}" wx:key="key" wx:for-item="reason" class="model-reason {{reason.value < 0 ? 'is-down' : ''}}"><text class="model-reason-text">{{reason.text}}</text><text class="model-delta">{{reason.value > 0 ? '+' + reason.value : reason.value}}</text></view></view></view><view class="result-days"><view wx:for="{{result.days}}" wx:key="label" wx:for-item="day" class="result-day"><view class="day-label"><text>{{day.label}}</text><text class="day-visit">{{day.visitLabel}}</text></view><view class="day-names">{{day.names}}</view></view></view><view class="result-estimate"><text>参考预算 {{result.estimateText}} / 人</text><view>{{result.estimateNote}}</view></view><view class="result-notes"><view class="result-notes-label">安排前留意</view><view wx:for="{{result.notes}}" wx:key="*this" wx:for-item="note" wx:if="{{index < 2 || result.notesOpen}}" class="result-note"><text class="note-dot">·</text><text>{{note}}</text></view><button wx:if="{{result.notes.length > 2}}" class="note-toggle" data-id="{{result.id}}" bindtap="toggleNotes">{{result.notesOpen ? '收起提醒 ⌃' : '展开全部 ' + result.notes.length + ' 条提醒 ⌄'}}</button></view><button class="primary adopt-button" data-id="{{result.id}}" bindtap="adopt" disabled="{{singlePage || adopting}}">采用这份方案，继续编辑<text>→</text></button></view>
    </view>
    <view wx:if="{{results.length}}" class="model-footnote">推荐分由本机模型计算：兴趣、距离、节奏、同行的人和新鲜度各占一定比重，不联网、不上传记录。</view>
    <view wx:if="{{results.length}}" class="planning-limit">游览时长是建议安排；道路、班次、营业时间与余票没有实时接入。采用后可以调顺序、停留时间与费用，出发前再核对开放和预约要求。</view>
  </view>
  <view class="create-footer"><button class="plain-link" bindtap="goEditor">{{draftCount ? '回到当前草稿' : '已有想法，自己排地点'}} →</button><button class="plain-link home-link" bindtap="home">返回首页</button></view>
</view>
