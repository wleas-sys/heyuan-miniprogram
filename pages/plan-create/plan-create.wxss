.generate-button,.adopt-button,.no-results .secondary{width:100%!important}.create-footer .plain-link,.no-results .plain-link{display:block;width:100%!important}

.note-toggle{font-size:22rpx;min-height:66rpx;color:#42633B;text-align:left;padding:12rpx 0 0;width:100%}

.result-estimate{padding:22rpx 0;border-top:1rpx solid #E2E9DE;color:#173F35;font-size:28rpx}.result-estimate view{font-size:21rpx;color:#748279;line-height:1.7;margin-top:8rpx}

.crowd-row{margin-top:24rpx;padding-top:22rpx;border-top:1rpx dashed #E2E9DE}
.crowd-label{display:flex;align-items:baseline;gap:12rpx;font-size:25rpx;color:#596D60;margin-bottom:14rpx}
.crowd-note{font-size:20rpx;color:#96A396}
.crowd-options{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx}
.crowd-choice{padding:14rpx 4rpx;border:1rpx solid #DFE6DC;border-radius:14rpx;background:#FAFBF8;font-size:23rpx;line-height:1.4;color:#40584A;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.crowd-choice.selected{background:#EDF3E9;border-color:#6B9273;color:#22462F;font-weight:600}
.model-block{margin:6rpx 0 20rpx;padding:20rpx 22rpx;background:#F7FAF4;border:1rpx solid #E1E9DC;border-radius:18rpx}
.model-head{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin-bottom:12rpx}
.model-title{font-size:23rpx;letter-spacing:1rpx;color:#3D5A47}
.model-score{display:flex;align-items:baseline;gap:6rpx}
.model-score-value{font-size:38rpx;line-height:1;font-weight:600;color:#173F35;font-variant-numeric:tabular-nums}
.model-score-unit{font-size:19rpx;color:#7E8F82}
.model-reasons{display:flex;flex-direction:column;gap:8rpx}
.model-reason{display:flex;align-items:baseline;justify-content:space-between;gap:14rpx;font-size:22rpx;line-height:1.6;color:#4A6152}
.model-reason-text{flex:1;min-width:0}
.model-delta{font-size:22rpx;color:#2F6B49;font-variant-numeric:tabular-nums;flex-shrink:0}
.model-reason.is-down .model-delta{color:#9D5142}
.model-footnote{margin-top:14rpx;padding:0 4rpx;font-size:20rpx;line-height:1.8;color:#8A978C}

/* ---- 质感层：规划表单 ---- */
.form-card{background:var(--card);border-color:var(--hairline);box-shadow:var(--shadow-sm);border-radius:30rpx}
.result-card{background:var(--card);border-color:var(--hairline);box-shadow:var(--shadow-sm);border-radius:28rpx}
.form-section{border-top-color:var(--hairline)}
