x}.footnote-item{display:flex;align-items:baseline;gap:18rpx;padding:9rpx 0;font-size:24rpx;color:#7E9172}.footnote-item>text{font-family:Georgia,serif;color:#A0AF90;font-size:24rpx}.source-section{margin-top:32rpx;border-top:1rpx solid #DFE6D7}.source-toggle{display:flex;justify-content:space-between;width:100%!important;text-align:left;font-size:22rpx;color:#8A9A7D;padding:24rpx 0}.source-list{padding:0 0 16rpx}.source-list button{display:flex;justify-content:space-between;align-items:center;gap:24rpx;width:100%!important;text-align:left;font-size:20rpx;color:#7D9270;padding:14rpx 0}.source-list button>text:last-child{white-space:nowrap;flex-shrink:0;color:#5F7F52}.source-date{font-size:19rpx;color:#A0AE93;display:block;margin-top:14rpx}.food-page .end-note{margin-top:16rpx}
