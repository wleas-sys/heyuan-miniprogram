.route-page{min-height:100vh}.route-hero{height:490rpx;background:#38573C;position:relative;color:#fff;overflow:hidden}.route-hero-photo,.route-hero-shade{position:absolute;left:0;top:0;width:100%;height:100%}.route-hero-shade{background:linear-gradient(180deg,rgba(14,39,25,.17),transparent 25%,rgba(12,35,23,.73));pointer-events:none}.route-hero-top{position:relative;display:flex;align-items:center;justify-content:space-between;padding:29rpx 32rpx;pointer-events:none}.route-badge{font-size:23rpx;border:1rpx solid rgba(255,255,255,.55);background:rgba(26,58,35,.2);border-radius:9rpx;padding:5rpx 16rpx}.route-serial{font-size:21rpx;letter-spacing:3rpx;opacity:.9}.route-hero-copy{position:absolute;bottom:48rpx;left:32rpx;right:32rpx;pointer-events:none}.route-region{font-size:23rpx;opacity:.8;letter-spacing:2rpx;margin-bottom:10rpx}.route-hero-title{font-size:44rpx;line-height:1.45;font-weight:650;letter-spacing:-.7rpx}.route-hero-subtitle{font-size:25rpx;opacity:.85;margin-top:13rpx;line-height:1.7}.route-content{position:relative;background:var(--paper);padding:0 32rpx 26rpx}.route-overview{position:relative;margin-top:-20rpx;border:1rpx solid #E1E8DE;background:#fff;border-radius:26rpx;display:flex;align-items:center;padding:28rpx 26rpx;gap:25rpx}.overview-item{min-width:116rpx;display:flex;flex-direction:column;border-right:1rpx solid #E7ECDF;padding-right:25rpx}.overview-value{font-family:Georgia,serif;font-size:46rpx;line-height:1.25;color:#355C3B}.overview-value text{font-family:-apple-system,"PingFang SC",sans-serif;font-size:22rpx}.overview-label{font-size:21rpx;color:#8B9780;margin-top:8rpx}.overview-note{font-size:24rpx;line-height:1.8;color:#819174;flex:1;min-width:0}.route-intro{font-size:28rpx;line-height:1.9;color:#586D4D;margin-top:30rpx}.route-day{margin-top:39rpx}.day-heading{display:flex;align-items:center;justify-content:space-between;gap:15rpx;margin-bottom:23rpx}.day-title{display:flex;align-items:center;gap:15rpx;font-size:32rpx;font-weight:650;color:#375B35}.day-no{display:flex;align-items:center;justify-content:center;background:#E1EBD9;color:#68845A;border-radius:11rpx;width:44rpx;height:44rpx;font-size:27rpx;font-family:Georgia,serif;font-weight:500}.day-count{font-size:22rpx;color:#88977B}.stop-row{display:flex;align-items:stretch;gap:17rpx;min-height:182rpx}.stop-track{width:29rpx;flex-shrink:0;position:relative;display:flex;justify-content:center}.stop-dot{margin-top:57rpx;width:29rpx;height:29rpx;background:#DDE8D3;border:1rpx solid #B5CAA5;color:#66834F;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18rpx;z-index:1}.stop-line{position:absolute;top:85rpx;bottom:-60rpx;width:2rpx;background:#DAE4D0;left:14rpx}.stop-card{flex:1;min-width:0;background:#fff;border:1rpx solid #E1E8DE;border-radius:23rpx;margin-bottom:18rpx;display:flex;align-items:center;gap:20rpx;padding:17rpx;min-height:162rpx}.stop-photo{width:116rpx;height:126rpx;flex-shrink:0;border-radius:15rpx;background:#E3EAD9}.stop-copy{flex:1;min-width:0}.stop-region{font-size:20rpx;color:#8B987E;margin-bottom:5rpx}.stop-title{font-size:28rpx;font-weight:600;color:#385833;line-height:1.5}.stop-time{font-size:21rpx;line-height:1.6;color:#8D987F;margin-top:7rpx}.stop-arrow{font-size:29rpx;color:#8B9D7A;flex-shrink:0}.route-notes{padding:28rpx;border:1rpx solid #DFE8D5;background:#ECF2E4;border-radius:26rpx;margin-top:26rpx}.notes-heading{font-size:30rpx;font-weight:600;color:#44623A;margin-bottom:15rpx}.route-note{display:flex;align-items:flex-start;gap:18rpx;font-size:25rpx;line-height:1.85;color:#6B7E59;padding:12rpx 0}.note-number{font-size:23rpx;font-family:Georgia,serif;color:#92A57E;flex-shrink:0;margin-top:3rpx}.reference-note{margin-top:29rpx;font-size:23rpx;line-height:1.8;color:#8D9982;padding:0 3rpx}.reference-label{color:#738765;font-size:23rpx;margin-bottom:8rpx}.cover-credit{font-size:20rpx;color:#A0A992;line-height:1.7;margin-top:21rpx;word-break:break-all}.route-end{text-align:center;font-size:21rpx;color:#99A38A;margin-top:30rpx}.route-dock{align-items:stretch;background:#fff}.route-dock .secondary{flex:0 0 180rpx;font-size:25rpx;background:#F1F4EC;border-color:#E1E8D9;color:#6B825B;padding:24rpx 16rpx;border-radius:18rpx}.route-dock .primary{flex:1;min-width:0;font-size:27rpx;padding:24rpx 15rpx;border-radius:18rpx}.route-dock .primary text{margin-left:10rpx}@media(max-width:350px){.route-hero-title{font-size:41rpx}.route-overview{gap:19rpx;padding:26rpx 21rpx}.overview-item{min-width:106rpx;padding-right:19rpx}.overview-note{font-size:23rpx}.stop-card{gap:15rpx;padding:15rpx}.stop-photo{width:105rpx;height:122rpx}.stop-title{font-size:27rpx}.route-dock .secondary{flex-basis:166rpx}.route-dock .primary{font-size:26rpx}}

/* ---- 质感层：路线页 ---- */
.route-hero-title{letter-spacing:-1.4rpx}
.route-overview{background:var(--card);border-color:var(--hairline);box-shadow:var(--shadow-md)}
.stop-card{background:var(--card);border-color:var(--hairline);box-shadow:var(--shadow-sm)}
.route-notes{background:linear-gradient(180deg,#F1F5EA,#ECF2E3);border-color:rgba(26,50,38,.07)}
.route-dock{background:rgba(255,254,251,.94);backdrop-filter:blur(18px);border-top-color:var(--hairline);box-shadow:0 -8rpx 30rpx rgba(24,45,34,.05)}
.overview-value{color:#2C5138}

/* ===== 纸墨编辑风 · 路线 ===== */
.route-hero{height:500rpx}
.route-hero-title{font-family:var(--serif);font-size:52rpx;letter-spacing:1rpx;font-weight:600}
.route-badge{border-radius:2rpx;letter-spacing:1rpx}
.route-serial{letter-spacing:4rpx}
.route-overview{border-radius:2rpx;box-shadow:none;border:1rpx solid var(--line);background:var(--card);margin-top:-28rpx}
.overview-value{font-family:var(--serif);color:var(--seal)}
.day-title{font-family:var(--serif);letter-spacing:.5rpx}
.day-no{border-radius:2rpx;font-family:var(--serif);background:var(--paper-2);color:var(--seal);border:1rpx solid var(--line)}
.stop-card{border-radius:2rpx;box-shadow:none;border:1rpx solid var(--line);background:var(--card)}
.stop-title{font-family:var(--serif);font-size:29rpx;letter-spacing:.3rpx}
.stop-photo{border-radius:2rpx}
.route-notes{border-radius:2rpx;background:var(--paper-2);border:1rpx solid var(--line)}
.notes-heading{font-family:var(--serif)}
.note-number{font-family:var(--serif);color:var(--seal)}
.route-dock{background:var(--paper);box-shadow:none;backdrop-filter:none}
.route-dock .primary,.route-dock .secondary{border-radius:2rpx}
