<view wx:if="{{singlePage}}" class="timeline-notice">正在预览。收藏与安排行程，请点击底部“前往小程序”。</view>
<view class="page tab-page places-page">
  <view class="browse-heading"><view><text class="browse-label">河源目的地手册</text><view class="browse-title">下一个，想去哪里</view></view><button class="saved-filter {{onlySaved ? 'selected' : ''}}" bindtap="toggleSaved" aria-label="{{onlySaved ? '显示全部地点' : '只看已收藏地点'}}"><view class="bookmark-icon"></view><text>收藏{{savedCount ? ' ' + savedCount : ''}}</text><view class="mini-switch {{onlySaved ? 'on' : ''}} {{switchElastic ? 'elastic' : ''}}"><view class="mini-knob"></view></view></button></view>
  <view class="search-box"><view class="search-icon"></view><input placeholder="搜索名称、区县或看点" placeholder-class="search-placeholder" value="{{keyword}}" bindinput="search" confirm-type="search" maxlength="40" aria-label="搜索名称、区县或看点"/><button wx:if="{{keyword}}" class="clear-search" bindtap="clearKeyword" aria-label="清空搜索">×</button></view>
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{catInto}}" scroll-with-animation><view class="category-row"><button wx:for="{{categories}}" wx:key="*this" id="cat-{{index}}" class="category-tab {{category === item ? 'active' : ''}}" data-value="{{item}}" bindtap="category">{{item === '全部' ? '全部目的地' : item}}</button></view></scroll-view>
  <scroll-view class="region-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{regionInto}}" scroll-with-animation><view class="region-row"><button wx:for="{{regions}}" wx:key="*this" id="reg-{{index}}" class="region-chip {{region === item ? 'active' : ''}}" data-value="{{item}}" bindtap="changeRegion">{{item}}</button></view></scroll-view>
  <view class="summary-dock {{summaryOpen ? 'open' : ''}} {{summaryDragging ? 'dragging' : ''}}">
    <view class="summary-pill" bindtouchstart="sumStart" catchtouchmove="sumMove" bindtouchend="sumEnd" bindtap="sumTap">
      <text class="summary-count">{{total}}</text><text class="summary-unit">个地点</text>
      <view class="summary-divide"></view>
      <text class="summary-scope">{{onlySaved ? '我的收藏' : (region === '全部地区' ? '全河源' : region)}}</text>
      <view class="summary-chevron {{summaryOpen ? 'up' : ''}}"></view>
    </view>
    <view class="summary-panel" style="height:{{summaryH}}rpx">
      <view class="summary-grid"><view wx:for="{{summaryStats}}" wx:key="label" class="summary-cell"><text class="summary-value">{{item.value}}</text><text class="summary-label">{{item.label}}</text></view></view>
      <view class="summary-foot">已收藏 {{savedCount}} 个 · 下拉展开，点空白收起</view>
    </view>
  </view>
  <view wx:if="{{summaryOpen}}" class="summary-dismiss" bindtap="closeSummary"></view>
  <view class="list-zone {{summaryOpen ? 'is-dim' : ''}}">
  <view class="results-head"><text><text class="result-number">{{total}}</text> 个地点{{onlySaved ? ' · 我的收藏' : ''}}</text><button wx:if="{{hasFilters}}" class="reset-filters" bindtap="clear">重置筛选</button><text wx:else class="results-note">按自己的节奏选</text></view>
  <view class="place-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="detail" hover-class="pressed">
    <view class="place-visual {{item.photo ? 'has-photo' : ''}}"><image wx:if="{{item.photo && !failedPhotos[item.id]}}" class="place-photo {{loadedPhotos[item.id] ? 'is-ready' : ''}}" mode="aspectFill" src="{{item.photo}}" lazy-load data-id="{{item.id}}" bindload="photoLoaded" binderror="photoFailed"/><view wx:else class="place-photo photo-pending">{{item.shortName}}</view><view class="photo-gradient"></view><text class="photo-region">{{item.region}} · {{item.category}}</text><button class="favorite-button {{item.saved ? 'is-saved' : ''}} {{poppedId === item.id ? 'pop' : ''}}" data-id="{{item.id}}" catchtap="favorite" aria-label="{{item.saved ? '取消收藏' + item.name : '收藏' + item.name}}" hover-class="favorite-pressed"><view class="bookmark-icon"></view><view wx:if="{{burstId === item.id}}" class="burst"><view wx:for="{{burstDots}}" wx:key="*this" class="burst-dot d{{item}}"></view></view></button></view>
    <view class="place-body"><view class="place-title-row"><view class="place-name">{{item.name}}</view><text class="place-arrow">↗</text></view><view class="place-teaser">{{item.teaser}}</view><view class="place-footer"><view class="place-tags"><text wx:for="{{item.cardTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view><text class="duration-text">{{item.durationText}}</text></view></view>
  </view>
  <view wx:if="{{!list.length}}" class="empty browse-empty"><view class="empty-symbol"><view class="search-icon"></view></view><view class="empty-title">{{onlySaved && !savedCount ? '先收下一个喜欢的地方' : '暂时没有匹配的地点'}}</view><view class="small muted">{{onlySaved && !savedCount ? '在地点卡片上点收藏，之后可以在这里找回来。' : '换一个关键词，或清除地区、分类筛选再看看。'}}</view><button class="primary" bindtap="clear">查看全部地点</button></view>
  <view wx:if="{{list.length}}" class="browse-end">
    <block wx:if="{{list.length < total}}"><button class="more-button" bindtap="more" hover-class="pressed">继续看剩下 {{total - list.length}} 个 ↓</button><view class="browse-count">已显示 {{list.length}} / {{total}}</view></block>
    <block wx:else>看到喜欢的地方，先收藏，再放进行程。</block>
  </view>
  </view>
</view>
