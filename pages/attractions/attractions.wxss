/* 交互补充：分页加载与收藏反馈 */
.more-button{width:100%!important;min-height:96rpx;margin-top:8rpx;padding:22rpx;border:1rpx solid #DCE6D7;border-radius:18rpx;background:#fff;color:#38624A;font-size:25rpx;display:flex;align-items:center;justify-content:center;gap:8rpx}
.browse-count{font-size:21rpx;color:#93A093;margin-top:14rpx;letter-spacing:1rpx}
@keyframes fav-pop{0%{transform:scale(.76)}55%{transform:scale(1.16)}100%{transform:scale(1)}}
.favorite-button{transition:background-color .2s ease,transform .16s ease}
.favorite-button.pop{animation:fav-pop .3s cubic-bezier(.3,1.4,.5,1)}
.favorite-button.pop .bookmark-icon{animation:fav-pop .3s cubic-bezier(.3,1.4,.5,1)}

/* 骨架落位：容器高度固定 332rpx，骨架与正式图同高，加载完淡入不跳动 */
.place-visual{overflow:hidden}
.place-visual.has-photo::before{content:"";position:absolute;left:0;top:0;right:0;bottom:0;background:linear-gradient(100deg,#E2EADF 28%,#F0F5EC 46%,#E2EADF 64%);background-size:220% 100%;animation:skeleton-sweep 1.5s linear infinite}
@keyframes skeleton-sweep{from{background-position:120% 0}to{background-position:-60% 0}}
.place-photo{position:relative;z-index:1;opacity:0;transition:opacity .32s ease}
.place-photo.is-ready{opacity:1}
.place-photo.photo-pending{opacity:1;position:relative;z-index:1}
.photo-gradient{z-index:2}
.photo-region{z-index:3}
.favorite-button{z-index:4;overflow:visible}

/* 弹性开关：滑钮起步拉长，落位收窄 */
.mini-switch{width:54rpx;height:31rpx;border-radius:16rpx;background:#DCE5D5;position:relative;flex-shrink:0;margin-left:2rpx;transition:background-color .22s ease}
.mini-switch.on{background:#386247}
.mini-knob{position:absolute;top:3rpx;left:3rpx;width:25rpx;height:25rpx;border-radius:50%;background:#fff;box-shadow:0 1rpx 4rpx rgba(20,45,29,.2);transition:left .26s cubic-bezier(.22,1,.36,1),width .18s ease}
.mini-switch.on .mini-knob{left:26rpx}
.mini-switch.elastic .mini-knob{width:32rpx}
.mini-switch.elastic.on .mini-knob{left:19rpx}

/* 点击爆散：只在收藏成功时，六粒微光向外散开 */
.burst{position:absolute;left:50%;top:50%;width:0;height:0;pointer-events:none}
.burst-dot{position:absolute;left:0;top:0;width:7rpx;height:7rpx;margin:-3.5rpx 0 0 -3.5rpx;border-radius:50%;background:#F4F8EF;opacity:0;animation:burst-out .52s cubic-bezier(.2,.7,.3,1) forwards}
.burst-dot.d0{--a:0deg}
.burst-dot.d1{--a:60deg}
.burst-dot.d2{--a:120deg}
.burst-dot.d3{--a:180deg}
.burst-dot.d4{--a:240deg}
.burst-dot.d5{--a:300deg}
@keyframes burst-out{0%{opacity:.9;transform:rotate(var(--a)) translateY(-8rpx) scale(.7)}100%{opacity:0;transform:rotate(var(--a)) translateY(-54rpx) scale(.25)}}

/* ---- 质感层：列表与筛选 ---- */
.browse-title{font-size:38rpx;font-weight:600;letter-spacing:-.8rpx}
.browse-label{letter-spacing:2.4rpx}
.saved-filter{border-color:#E1E6DA;background:var(--card);box-shadow:0 1rpx 2rpx rgba(24,45,34,.03)}
.saved-filter.selected{background:#E8EFE1;border-color:#CBDCC2;box-shadow:none}
.search-box{border-color:#E3E7DC;background:var(--card);box-shadow:var(--shadow-sm)}
.category-tab{font-size:26rpx;letter-spacing:.3rpx}
.category-tab.active{font-weight:600}
.category-tab.active:after{height:4rpx;border-radius:4rpx;background:#2E5B45;left:24%;right:24%}
.region-chip{background:#F3F5EF;border-color:#E7EADF;color:#6C7A6D}
.region-chip.active{background:#E7EFE0;border-color:#CBDCC2;color:#2E4F3A;font-weight:600}
.place-card{border-color:rgba(26,50,38,.07);border-radius:30rpx;box-shadow:var(--shadow-sm);background:var(--card)}
.place-visual{height:336rpx}
.place-body{padding:24rpx 28rpx 26rpx}
.place-name{font-size:31rpx;letter-spacing:-.3rpx}
.photo-region{font-size:22rpx;letter-spacing:.8rpx}
.favorite-button{background:rgba(255,254,251,.92);box-shadow:0 2rpx 10rpx rgba(20,45,29,.14)}
.more-button{border-color:rgba(26,50,38,.1);background:var(--card);box-shadow:var(--shadow-sm)}

/* ===== 纸墨编辑风 · 景点列表 ===== */
.browse-heading{align-items:flex-end;padding-bottom:18rpx;border-bottom:1rpx solid var(--line)}
.browse-title{font-family:var(--serif);font-size:44rpx;letter-spacing:1rpx;line-height:1.25;margin-top:8rpx}
.browse-label{font-size:18rpx;letter-spacing:4rpx;color:var(--seal)}
.saved-filter{border-radius:2rpx;border:1rpx solid var(--line-strong);background:transparent;box-shadow:none;font-size:21rpx;letter-spacing:1rpx}
.saved-filter.selected{background:var(--paper-2);border-color:var(--line-strong);color:var(--ink)}
.mini-switch{border-radius:2rpx;background:var(--line-strong)}
.mini-switch.on{background:var(--seal)}
.mini-knob{border-radius:1rpx;box-shadow:none}
.search-box{border-radius:2rpx;border:1rpx solid var(--line-strong);background:transparent;box-shadow:none;margin-top:22rpx}
.category-scroll{border-bottom:1rpx solid var(--line);margin-top:20rpx}
.category-tab{font-size:25rpx;letter-spacing:1rpx;color:var(--muted);padding:16rpx 2rpx 18rpx}
.category-tab.active{color:var(--ink);font-weight:600}
.category-tab.active:after{height:3rpx;left:0;right:0;width:100%;background:var(--seal);border-radius:0}
.region-chip{border-radius:2rpx;background:transparent;border:1rpx solid var(--line);color:var(--ink-2);font-size:22rpx;letter-spacing:.5rpx}
.region-chip.active{background:var(--green);border-color:var(--green);color:var(--paper);font-weight:500}
.results-head{border-bottom:1rpx solid var(--line);padding-bottom:12rpx;margin:6rpx 0 22rpx}
.result-number{font-family:var(--serif);font-size:32rpx;color:var(--seal);margin-right:6rpx}
.place-card{border-radius:2rpx;border:1rpx solid var(--line);background:var(--card);box-shadow:none;margin-bottom:28rpx}
.place-visual{height:340rpx}
.photo-region{font-size:18rpx;letter-spacing:2rpx;left:20rpx;bottom:18rpx}
.favorite-button{border-radius:2rpx;background:rgba(250,248,241,.92);box-shadow:none;width:64rpx!important;height:64rpx}
.favorite-button.is-saved{background:var(--seal)}
.place-body{padding:24rpx 24rpx 26rpx}
.place-name{font-family:var(--serif);font-size:34rpx;letter-spacing:.5rpx;line-height:1.35}
.place-arrow{color:var(--seal);font-size:26rpx}
.place-teaser{font-size:23rpx;color:var(--ink-2);line-height:1.75}
.place-footer{border-top:1rpx solid var(--line);padding-top:16rpx;margin-top:18rpx}
.place-tags text{border:1rpx solid var(--line);background:transparent;border-radius:2rpx;color:var(--ink-2);font-size:19rpx;letter-spacing:.5rpx}
.duration-text{font-size:20rpx;letter-spacing:.5rpx}
.more-button{border-radius:2rpx;border:1rpx solid var(--line-strong);background:transparent}
.browse-end{font-size:20rpx;letter-spacing:1rpx}

/* ===== 下拉摘要：单行胶囊 → 跟手展开统计 ===== */
.summary-dock{position:relative;z-index:6;margin:10rpx 0 4rpx}
.summary-pill{display:flex;align-items:center;gap:10rpx;height:74rpx;padding:0 18rpx;border:1rpx solid var(--line-strong);background:var(--card);border-radius:2rpx}
.summary-count{font-family:var(--serif);font-size:34rpx;color:var(--seal);line-height:1}
.summary-unit{font-size:20rpx;color:var(--muted);letter-spacing:1rpx}
.summary-divide{width:1rpx;height:22rpx;background:var(--line);margin:0 6rpx}
.summary-scope{flex:1;min-width:0;font-size:21rpx;color:var(--ink-2);letter-spacing:.5rpx}
.summary-chevron{width:10rpx;height:10rpx;border-right:2rpx solid var(--muted);border-bottom:2rpx solid var(--muted);transform:rotate(45deg);transition:transform .28s cubic-bezier(.34,1.4,.64,1);margin-top:-4rpx}
.summary-chevron.up{transform:rotate(-135deg);margin-top:4rpx}
.summary-panel{height:0;overflow:hidden;background:var(--paper-2);border:1rpx solid transparent;transition:height .32s cubic-bezier(.22,1,.36,1)}
.summary-dock.open .summary-panel{border-color:var(--line);margin-top:8rpx}
.summary-dock.dragging .summary-panel{transition:none}
.summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rpx;background:var(--line);margin:1rpx}
.summary-cell{background:var(--paper-2);padding:16rpx 18rpx;display:flex;align-items:baseline;gap:10rpx}
.summary-value{font-family:var(--serif);font-size:34rpx;color:var(--ink)}
.summary-label{font-size:19rpx;color:var(--muted);letter-spacing:1rpx}
.summary-foot{padding:12rpx 18rpx 14rpx;font-size:18rpx;color:var(--muted);letter-spacing:.5rpx}
.summary-dismiss{position:fixed;left:0;right:0;top:0;bottom:0;z-index:4;background:transparent}
.list-zone{transition:opacity .24s ease}
.list-zone.is-dim{opacity:.3;pointer-events:none}
