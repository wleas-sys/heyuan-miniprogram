<view wx:if="{{singlePage}}" class="timeline-notice">正在预览分享内容。保存、编辑或查看更多，请点击微信底部的“前往小程序”。</view>
<view class="page tab-page profile-page">
  <view class="profile-heading"><view class="heading-text"><text class="eyebrow">万绿智游 · 我的</text><view class="title">我的出行手册</view><view class="subtitle">想去的地方，安排好的行程。</view></view><view class="notebook-mark"><view></view><text>旅</text></view></view>
  <view class="section profile-stats"><button class="stat-card" bindtap="favorites" hover-class="pressed"><view class="stat">{{favDisplay}}<text>个</text></view><view class="stat-label">收藏地点<text>↗</text></view></button><view class="stat-card"><view class="stat">{{planDisplay}}<text>份</text></view><view class="stat-label">保存行程<text class="capacity">最多 30 份</text></view></view></view>
  <button class="draft-entry" bindtap="plan" hover-class="pressed"><view class="draft-icon">＋</view><view class="grow"><view class="draft-title">{{draftCount ? '接着安排这趟旅行' : '开始一份新行程'}}</view><view class="draft-description">{{draftCount ? draftTitle + ' · ' + draftDays + ' 天 ' + draftCount + ' 站' : '选好想去的地点，再排每天的顺序'}}</view></view><text class="draft-arrow">→</text></button>
  <view class="section saved-section"><view class="section-head"><text class="section-title">保存的行程</text><text class="small muted">保存在本机</text></view>
    <view wx:if="{{plans.length > 2}}" class="plan-search"><text>⌕</text><input value="{{query}}" bindinput="search" placeholder="搜行程名称或地点" confirm-type="search" /><button wx:if="{{query}}" bindtap="clearSearch" aria-label="清空行程搜索">×</button></view>
    <view wx:if="{{!plans.length}}" class="empty saved-empty"><view class="empty-lines"><view></view><view></view><view></view></view><view class="empty-title">把想去的地方排成一趟旅行</view><view class="small muted">在行程页点击“保存行程”，<view>就会出现在这里。</view></view><button class="primary" bindtap="plan">安排第一份行程 →</button></view>
    <view wx:elif="{{!visiblePlans.length}}" class="empty"><view class="empty-title">没有找到这份行程</view><view class="small muted">可以换一个地点或名称搜索。</view><button class="link reset-search" bindtap="clearSearch">查看全部行程</button></view>
    <view wx:for="{{visiblePlans}}" wx:key="id" class="saved-plan card"><view class="saved-main" data-id="{{item.id}}" bindtap="open" hover-class="pressed"><image wx:if="{{item.photo && !failedPhotos[item.id]}}" class="saved-photo" src="{{item.photo}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="photoError" /><view wx:else class="saved-photo saved-placeholder">旅</view><view class="grow"><view class="place-name">{{item.title}}</view><view class="saved-meta">{{item.days.length}} 天 · {{item.count}} 个地点 · {{item.travelDate}}</view><view class="saved-regions">{{item.regionText}}</view></view><text class="saved-arrow">›</text></view><view class="saved-stops" data-id="{{item.id}}" bindtap="open">{{item.stopsText}}</view><view class="saved-footer"><text>{{item.dateText}} 更新</text><button class="delete-button" data-id="{{item.id}}" bindtap="remove">删除</button><button class="open-button" data-id="{{item.id}}" bindtap="open">打开行程 →</button></view></view>
  </view>
  <view wx:if="{{legacyCount}}" class="section card legacy-card"><view class="place-name">发现 {{legacyCount}} 份旧版行程</view><view class="small muted">导入兼容的地点顺序，旧记录会继续保留。</view><button class="link" bindtap="importLegacy">导入旧版行程 →</button></view>
  <button class="section about-row" bindtap="about"><view class="grow"><view class="about-name">关于万绿智游</view><view class="small muted">资料来源 · 图片署名 · 版本说明</view></view><text class="version-tag">V2.2</text><text class="about-arrow">›</text></button>
  <view class="end-note">无需登录。更换设备或清理数据前，<view>请先分享留存重要行程。</view></view>
</view>
